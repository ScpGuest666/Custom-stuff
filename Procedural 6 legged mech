-- Helper: Create a Part
local function createPart(size, color, material, parent)
    local p = Instance.new("Part")
    p.Size = size
    p.Color = color
    p.Material = material
    p.Anchored = true
    p.CanCollide = false
    p.CastShadow = false
    p.Parent = parent
    return p
end

-- Helper: Construct CFrame spanning between two exact 3D points
local function getSegmentCFrame(p1, p2)
    local length = (p2 - p1).Magnitude
    local mid = (p1 + p2) * 0.5
    return CFrame.lookAt(mid, p2), length
end

-- Precise 3D Analytical 2-Bone IK Solver for Spider Joints
local function solveLegJoints(hipCF, targetFoot)
    local hipPos = hipCF.Position
    -- Coxa extends outwards in the hip's forward direction
    local coxaEnd = hipPos + (hipCF.LookVector * COXA_LEN)
    
    local toFoot = targetFoot - coxaEnd
    local dist = toFoot.Magnitude
    local maxReach = (FEMUR_LEN + TIBIA_LEN) * 0.985
    
    -- Prevent joint dislocation if target is out of reach
    if dist > maxReach then
        toFoot = toFoot.Unit * maxReach
        targetFoot = coxaEnd + toFoot
        dist = maxReach
    end
    dist = math.max(dist, 0.1)

    -- Triangle law of cosines: Femur, Tibia, Reach Distance
    local cosAlpha = (FEMUR_LEN^2 + dist^2 - TIBIA_LEN^2) / (2 * FEMUR_LEN * dist)
    local alpha = math.acos(math.clamp(cosAlpha, -1, 1))

    -- Construct vertical bending plane (spider knee arches upwards)
    local footDir = toFoot.Unit
    local planeRight = footDir:Cross(Vector3.new(0, 1, 0))
    if planeRight.Magnitude < 0.001 then
        planeRight = hipCF.RightVector
    else
        planeRight = planeRight.Unit
    end
    
    local planeUp = planeRight:Cross(footDir).Unit

    -- Calculate exact knee position arched in the upward plane
    local kneePos = coxaEnd + (footDir * (math.cos(alpha) * FEMUR_LEN)) + (planeUp * (math.sin(alpha) * FEMUR_LEN))

    local coxaCF = getSegmentCFrame(hipPos, coxaEnd)
    local femurCF = getSegmentCFrame(coxaEnd, kneePos)
    local tibiaCF = getSegmentCFrame(kneePos, targetFoot)

    return coxaCF, femurCF, tibiaCF
end

-- Hexapod Builder
local function buildHexapod()
    if hexapodModel then
        hexapodModel:Destroy()
        hexapodModel = nil
    end

    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    hexapodModel = Instance.new("Model")
    hexapodModel.Name = "ProceduralHexapod"
    hexapodModel.Parent = workspace

    -- Spider abdomen/thorax main chassis
    body = createPart(Vector3.new(5.5, 2.2, 7.5), Color3.fromRGB(22, 22, 25), Enum.Material.SmoothPlastic, hexapodModel)
    
    targetMarker = createPart(Vector3.new(2.5, 0.05, 2.5), Color3.fromRGB(0, 255, 170), Enum.Material.Neon, hexapodModel)
    targetMarker.Transparency = 1

    local legConfigs = {
        -- Left Legs (Angles configured for a realistic spider splay)
        {Offset = CFrame.new(-2.6, 0, -2.6) * CFrame.Angles(0, math.rad(45), 0),   Ideal = Vector3.new(-8.5, -RIDE_HEIGHT, -6.5), Group = 1},
        {Offset = CFrame.new(-2.8, 0, 0)    * CFrame.Angles(0, math.rad(90), 0),   Ideal = Vector3.new(-10.0, -RIDE_HEIGHT, 0.0), Group = 2},
        {Offset = CFrame.new(-2.6, 0, 2.6)  * CFrame.Angles(0, math.rad(135), 0),  Ideal = Vector3.new(-8.5, -RIDE_HEIGHT, 6.5),  Group = 1},
        -- Right Legs
        {Offset = CFrame.new(2.6, 0, -2.6)  * CFrame.Angles(0, math.rad(-45), 0),  Ideal = Vector3.new(8.5, -RIDE_HEIGHT, -6.5),  Group = 2},
        {Offset = CFrame.new(2.8, 0, 0)     * CFrame.Angles(0, math.rad(-90), 0),  Ideal = Vector3.new(10.0, -RIDE_HEIGHT, 0.0),  Group = 1},
        {Offset = CFrame.new(2.6, 0, 2.6)   * CFrame.Angles(0, math.rad(-135), 0), Ideal = Vector3.new(8.5, -RIDE_HEIGHT, 6.5),  Group = 2},
    }

    legs = {}
    targetPos = hrp.Position
    local lookVec = hrp.CFrame.LookVector
    currentRotationYaw = math.atan2(-lookVec.X, -lookVec.Z)
    lastValidGroundY = hrp.Position.Y - 2
    currentGaitGroup = 1
    bodyTiltCFrame = CFrame.new()

    body.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 5, 0)) * CFrame.Angles(0, currentRotationYaw, 0)

    for _, cfg in ipairs(legConfigs) do
        local idealWorldPos = (body.CFrame * CFrame.new(cfg.Ideal)).Position
        
        table.insert(legs, {
            Coxa = createPart(Vector3.new(1.3, 1.3, COXA_LEN), Color3.fromRGB(35, 35, 40), Enum.Material.SmoothPlastic, hexapodModel),
            Femur = createPart(Vector3.new(1.0, 1.0, FEMUR_LEN), Color3.fromRGB(55, 55, 62), Enum.Material.SmoothPlastic, hexapodModel),
            Tibia = createPart(Vector3.new(0.8, 0.8, TIBIA_LEN), Color3.fromRGB(20, 20, 24), Enum.Material.SmoothPlastic, hexapodModel),
            HipOffset = cfg.Offset,
            IdealOffset = cfg.Ideal,
            Group = cfg.Group,
            CurrentFootPos = idealWorldPos,
            TargetFootPos = idealWorldPos,
            StartFootPos = idealWorldPos,
            IsStepping = false,
            StepTime = 0
        })
    end
end

-- Teardown Spider
local function destroyHexapod()
    if runConnection then
        runConnection:Disconnect()
        runConnection = nil
    end
    if hexapodModel then
        hexapodModel:Destroy()
        hexapodModel = nil
    end
    body = nil
    table.clear(legs)
end

-- Animation & Movement Loop
local function startAnimation()
    if runConnection then runConnection:Disconnect() end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    runConnection = RunService.Heartbeat:Connect(function(dt)
        if not body or not hexapodModel or not body.Parent then return end
        
        local char = player.Character
        rayParams.FilterDescendantsInstances = {hexapodModel, char}

        local flatTarget = Vector3.new(targetPos.X, 0, targetPos.Z)
        local flatBody = Vector3.new(body.Position.X, 0, body.Position.Z)
        local toTarget = flatTarget - flatBody
        local dist = toTarget.Magnitude

        -- 1. YAW & ROTATION
        local targetYaw = currentRotationYaw
        if dist > 1.5 then
            targetYaw = math.atan2(-toTarget.X, -toTarget.Z)
        end

        local angleDiff = (targetYaw - currentRotationYaw + math.pi) % (math.pi * 2) - math.pi
        local turnStep = math.clamp(angleDiff, -MAX_TURN_RATE * dt, MAX_TURN_RATE * dt)
        currentRotationYaw = currentRotationYaw + turnStep

        -- 2. MOVEMENT VELOCITY
        local isFacingTarget = math.abs(angleDiff) < math.rad(35)
        local currentSpeed = (dist > 2.5 and isFacingTarget) and MAX_MOVEMENT_SPEED or 0
        local forwardDir = Vector3.new(-math.sin(currentRotationYaw), 0, -math.cos(currentRotationYaw))
        local moveVelocity = forwardDir * currentSpeed

        -- 3. TERRAIN PROBING & SUSPENSION
        local groundHeights = {}
        local probePoints = { body.Position }
        for _, leg in ipairs(legs) do
            table.insert(probePoints, (body.CFrame * leg.HipOffset).Position)
        end

        for _, point in ipairs(probePoints) do
            local ray = workspace:Raycast(point + Vector3.new(0, 8, 0), Vector3.new(0, -35, 0), rayParams)
            if ray then
                table.insert(groundHeights, ray.Position.Y)
            end
        end

        table.sort(groundHeights)
        local detectedGroundY = #groundHeights > 0 and groundHeights[math.ceil(#groundHeights / 2)] or nil

        if detectedGroundY then
            lastValidGroundY = math.lerp(lastValidGroundY, detectedGroundY, 0.2)
        else
            lastValidGroundY = lastValidGroundY - (GRAVITY_FORCE * dt)
        end

        local targetY = lastValidGroundY + RIDE_HEIGHT
        local nextBodyPos = Vector3.new(
            body.Position.X + (moveVelocity.X * dt),
            math.lerp(body.Position.Y, targetY, 0.15),
            body.Position.Z + (moveVelocity.Z * dt)
        )

        body.CFrame = CFrame.new(nextBodyPos) * CFrame.Angles(0, currentRotationYaw, 0)

        -- 4. ALTERNATING TRIPOD GAIT LOGIC
        local group1Stepping, group2Stepping = false, false
        local group1NeedsStep, group2NeedsStep = false, false

        for _, leg in ipairs(legs) do
            if leg.IsStepping then
                if leg.Group == 1 then group1Stepping = true end
                if leg.Group == 2 then group2Stepping = true end
            end

            local idealFoot = (body.CFrame * CFrame.new(leg.IdealOffset)).Position
            local stepDist = (Vector3.new(leg.CurrentFootPos.X, 0, leg.CurrentFootPos.Z) - Vector3.new(idealFoot.X, 0, idealFoot.Z)).Magnitude

            if stepDist > STEP_THRESHOLD then
                if leg.Group == 1 then group1NeedsStep = true end
                if leg.Group == 2 then group2NeedsStep = true end
            end
        end

        if currentGaitGroup == 1 and not group1Stepping and group2NeedsStep then
            currentGaitGroup = 2
        elseif currentGaitGroup == 2 and not group2Stepping and group1NeedsStep then
            currentGaitGroup = 1
        end

        -- 5. STEP EXECUTION & IK JOINT SOLVING
        for _, leg in ipairs(legs) do
            local hipWorld = body.CFrame * leg.HipOffset
            local idealFoot = (body.CFrame * CFrame.new(leg.IdealOffset)).Position
            
            -- Step forward-prediction based on movement velocity
            local predictedStep = idealFoot + (moveVelocity * STEP_DURATION * 1.1)

            if leg.Group == currentGaitGroup and not leg.IsStepping then
                local shouldStep = (leg.Group == 1 and group1NeedsStep) or (leg.Group == 2 and group2NeedsStep)
                if shouldStep then
                    leg.IsStepping = true
                    leg.StepTime = 0
                    leg.StartFootPos = leg.CurrentFootPos
                    
                    local ray = workspace:Raycast(predictedStep + Vector3.new(0, 10, 0), Vector3.new(0, -30, 0), rayParams)
                    leg.TargetFootPos = ray and ray.Position or Vector3.new(predictedStep.X, lastValidGroundY, predictedStep.Z)
                end
            end

            if leg.IsStepping then
                leg.StepTime = leg.StepTime + dt
                local t = math.clamp(leg.StepTime / STEP_DURATION, 0, 1)
                -- Smooth Quintic Ease-In-Out
                local alpha = t * t * t * (t * (t * 6 - 15) + 10)
                local arcHeight = math.sin(t * math.pi) * BASE_STEP_HEIGHT
                
                leg.CurrentFootPos = leg.StartFootPos:Lerp(leg.TargetFootPos, alpha) + Vector3.new(0, arcHeight, 0)
                if t >= 1 then
                    leg.IsStepping = false
                end
            end

            -- Update Joint Transforms
            local coxaCF, femurCF, tibiaCF = solveLegJoints(hipWorld, leg.CurrentFootPos)
            leg.Coxa.CFrame = coxaCF
            leg.Femur.CFrame = femurCF
            leg.Tibia.CFrame = tibiaCF
        end
    end)
end

-- Double Tap Input for Setting Destination
inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local now = tick()
        if now - lastTapTime < 0.35 then
            local mousePos = UserInputService:GetMouseLocation()
            local unitRay = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
            local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000)
            if result and targetMarker then
                targetPos = result.Position
                targetMarker.Position = result.Position + Vector3.new(0, 0.1, 0)
                targetMarker.Transparency = 0.3
            end
        end
        lastTapTime = now
    end
end)
registerCleanup(inputConnection)
registerCleanup(function()
    destroyHexapod()
end)

