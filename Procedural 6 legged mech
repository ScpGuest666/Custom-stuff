local getgenv = getgenv or function() return _G end
local genv = getgenv()

-- Kill and clean up the previous instance if it is already running
if genv.Hexapod_Cleanup and type(genv.Hexapod_Cleanup) == "function" then
    pcall(genv.Hexapod_Cleanup)
    genv.Hexapod_Cleanup = nil
end

-- Cleanup manager for tracking UI, connections, threads, and instances
local cleanupTasks = {}
local isAlive = true

local function registerCleanup(item)
    table.insert(cleanupTasks, item)
    return item
end

local function cleanup()
    isAlive = false

    for _, item in ipairs(cleanupTasks) do
        pcall(function()
            if typeof(item) == "RBXScriptConnection" then
                item:Disconnect()
            elseif typeof(item) == "Instance" then
                item:Destroy()
            elseif type(item) == "thread" then
                task.cancel(item)
            elseif type(item) == "function" then
                item()
            end
        end)
    end
    table.clear(cleanupTasks)

    if genv.Hexapod_Cleanup == cleanup then
        genv.Hexapod_Cleanup = nil
    end
end

-- Store this instance's cleanup function globally
genv.Hexapod_Cleanup = cleanup

