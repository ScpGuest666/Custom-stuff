-- HEXAPOD CONFIGURATION & JOINT PROPORTIONS
-- ============================================================================
local MAX_MOVEMENT_SPEED = 14
local MAX_TURN_RATE = math.rad(65)
local RIDE_HEIGHT = 7.5
local BASE_STEP_HEIGHT = 3.2
local STEP_DURATION = 0.24
local STEP_THRESHOLD = 3.2
local GRAVITY_FORCE = 45

-- Realistic joint segment lengths
local COXA_LEN = 2.8
local FEMUR_LEN = 7.0
local TIBIA_LEN = 9.5

-- State variables
local hexapodModel = nil
local runConnection = nil
local inputConnection = nil
local legs = {}
local body = nil
local targetPos = nil
local targetMarker = nil
local lastTapTime = 0

