-- 6. Connected Lines & Smooth Full-Path Arrow
-- ----------------------------------------------------
local function showPath(word, path)
    if lastDisplayedWord == word and #activeVisualObjects > 0 then
        return
    end

    clearHighlights()
    if #path == 0 then return end
    lastDisplayedWord = word

    -- Show Virtual Input indicator at start letter
    local startPos = getTileCenter(path[1])
    virtualInputContainer.Position = UDim2.new(0, startPos.X + POINTER_OFFSET_X, 0, startPos.Y + POINTER_OFFSET_Y)
    virtualInputContainer.Visible = true
    inputLabel.Text = "START"
    inputLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    inputRingStroke.Color = Color3.fromRGB(255, 200, 0)
    pointer.BackgroundColor3 = Color3.fromRGB(255, 40, 40)

    local colorStart = Color3.fromRGB(255, 50, 50)
    local colorEnd = Color3.fromRGB(40, 140, 255)

    -- 1. Step Badges
    for step, tile in ipairs(path) do
        if tile.gui and tile.gui.Parent then
            local t = (#path > 1) and ((step - 1) / (#path - 1)) or 0
            local stepColor = colorStart:Lerp(colorEnd, t)

            local marker = Instance.new("TextLabel")
            marker.Name = "SolverBadge"
            marker.Parent = tile.gui
            marker.Size = UDim2.new(0, 20, 0, 20)
            marker.Position = UDim2.new(0, 0, 0, 0)
            marker.BackgroundColor3 = stepColor
            marker.TextColor3 = Color3.fromRGB(255, 255, 255)
            marker.Text = tostring(step)
            marker.Font = Enum.Font.GothamBold
            marker.TextSize = 11
            marker.ZIndex = 999
            Instance.new("UICorner", marker).CornerRadius = UDim.new(1, 0)
            
            table.insert(activeVisualObjects, marker)
        end
    end

    -- 2. Line Segments
    if #path > 1 then
        for i = 1, #path - 1 do
            local p1 = getTileCenter(path[i])
            local p2 = getTileCenter(path[i + 1])

            local dx = p2.X - p1.X
            local dy = p2.Y - p1.Y
            local length = math.sqrt(dx * dx + dy * dy)
            local angle = math.deg(math.atan2(dy, dx))
            local midpoint = Vector2.new((p1.X + p2.X) / 2, (p1.Y + p2.Y) / 2)

            local t = (i - 1) / math.max(1, #path - 2)
            local segColor = colorStart:Lerp(colorEnd, t)

            local line = Instance.new("Frame")
            line.Name = "UnbrokenLine_" .. i
            line.Parent = effectsFolder
            line.BackgroundColor3 = segColor
            line.BackgroundTransparency = 0.5
            line.BorderSizePixel = 0
            line.AnchorPoint = Vector2.new(0.5, 0.5)
            line.Position = UDim2.new(0, midpoint.X, 0, midpoint.Y)
            line.Size = UDim2.new(0, length, 0, 6)
            line.Rotation = angle
            line.ZIndex = 400
            Instance.new("UICorner", line).CornerRadius = UDim.new(1, 0)

            table.insert(activeVisualObjects, line)
        end

        -- 3. Animated Arrow
        local arrow = Instance.new("TextLabel")
        arrow.Name = "SolverArrow"
        arrow.Parent = effectsFolder
        arrow.Size = UDim2.new(0, 22, 0, 22)
        arrow.AnchorPoint = Vector2.new(0.5, 0.5)
        arrow.BackgroundTransparency = 1
        arrow.BorderSizePixel = 0
        arrow.Text = "▶"
        arrow.TextColor3 = Color3.fromRGB(255, 235, 40)
        arrow.TextScaled = true
        arrow.Font = Enum.Font.GothamBold
        arrow.ZIndex = 1000
        table.insert(activeVisualObjects, arrow)

        currentAnimThread = task.spawn(function()
            while true do
                local sPos = getTileCenter(path[1])
                arrow.Position = UDim2.new(0, sPos.X, 0, sPos.Y)

                for i = 1, #path - 1 do
                    local p1 = getTileCenter(path[i])
                    local p2 = getTileCenter(path[i + 1])
                    local angle = math.deg(math.atan2(p2.Y - p1.Y, p2.X - p1.X))
                    arrow.Rotation = angle

                    local tween = TweenService:Create(
                        arrow,
                        TweenInfo.new(0.22, Enum.EasingStyle.Linear),
                        { Position = UDim2.new(0, p2.X, 0, p2.Y) }
                    )
                    tween:Play()
                    tween.Completed:Wait()
                end
                task.wait(0.3)
            end
        end)
    end
end

