-- 7. Main UI Updater
-- ----------------------------------------------------
local function updateUI()
    if not dictionaryLoaded or isFilling then return end

    local grid, size = readGrid()

    if not grid then
        if isRoundActive then
            isRoundActive = false
            resetRoundState()
        end
        status.Text = "Intermission..."
        status.TextColor3 = Color3.fromRGB(255, 200, 0)
        return
    end

    if not isRoundActive then
        isRoundActive = true
        resetRoundState()
    end

    syncFoundWords()
    local unfound = solveGrid(grid, size)

    for _, child in ipairs(wordListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    status.Text = string.format("Left: %d words", #unfound)
    status.TextColor3 = #unfound > 0 and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(255, 80, 80)

    if #unfound > 0 then
        currentTopWord = unfound[1].word
        currentTopPath = unfound[1].path
        showPath(unfound[1].word, unfound[1].path)
    else
        currentTopWord = nil
        currentTopPath = nil
        clearHighlights()
    end

    for i, item in ipairs(unfound) do
        local btn = Instance.new("TextButton")
        btn.Parent = wordListFrame
        btn.Size = UDim2.new(1, 0, 0, 16)
        btn.BackgroundColor3 = (item.word == currentTopWord) and Color3.fromRGB(45, 75, 45) or Color3.fromRGB(36, 36, 44)
        btn.Text = string.format(" %d. %s", i, item.word)
        btn.TextColor3 = Color3.fromRGB(240, 240, 240)
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 10
        btn.TextXAlignment = Enum.TextXAlignment.Left
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)

        btn.MouseButton1Click:Connect(function()
            currentTopWord = item.word
            currentTopPath = item.path
            showPath(item.word, item.path)
        end)
    end

    wordListFrame.CanvasSize = UDim2.new(0, 0, 0, #unfound * 18)
end

-- ----------------------------------------------------
-- 8. Synchronized Auto-Fill & Validation Routine
-- ----------------------------------------------------
local function executeFillCurrent()
    if isFilling or not isRoundActive or not currentTopPath or not currentTopWord then
        return false
    end

    local candidateWord = currentTopWord
    local candidatePath = currentTopPath
    local prevWords = lastWordsCount
    local prevScore = lastScoreValue

    local success = performVirtualDrag(candidatePath)
    if not success then return false end

    -- Wait for the game to process submission and animate
    task.wait(POST_SUBMIT_DELAY)
    syncFoundWords()

    -- Check if word was accepted
    if usedWordsThisRound[candidateWord] or lastWordsCount > prevWords or lastScoreValue > prevScore then
        usedWordsThisRound[candidateWord] = true
    else
        -- Word was invalid / not accepted by the game dictionary
        rejectedWords[candidateWord] = true
    end

    pcall(updateUI)
    return true
end

-- User manual drag rejection detection
local isUserDragging = false

UserInputService.InputBegan:Connect(function(input)
    if not isFilling and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
        isUserDragging = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not isFilling and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and isUserDragging then
        isUserDragging = false
        
        local candidateToTest = currentTopWord
        if candidateToTest and isRoundActive then
            local prevWords = lastWordsCount
            local prevScore = lastScoreValue

            task.delay(0.35, function()
                syncFoundWords()
                if not usedWordsThisRound[candidateToTest] and lastWordsCount == prevWords and lastScoreValue == prevScore then
                    rejectedWords[candidateToTest] = true
                    pcall(updateUI)
                end
            end)
        end
    end
end)

-- Button Listeners
scanBtn.MouseButton1Click:Connect(function()
    pcall(updateUI)
end)

fillBtn.MouseButton1Click:Connect(function()
    task.spawn(executeFillCurrent)
end)

autoBtn.MouseButton1Click:Connect(function()
    autoEnabled = not autoEnabled
    autoBtn.Text = autoEnabled and "Auto: ON" or "Auto: OFF"
    autoBtn.BackgroundColor3 = autoEnabled and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(180, 50, 50)
end)

destroyBtn.MouseButton1Click:Connect(function()
    autoEnabled = false
    clearHighlights()
    releaseInputFailsafe()
    screenGui:Destroy()
end)

-- Continuous Auto-Fill & Scanning Loop
task.spawn(function()
    while true do
        if dictionaryLoaded and not isFilling then
            pcall(updateUI)

            if autoEnabled and isRoundActive and currentTopPath then
                executeFillCurrent()
                task.wait(0.1)
            else
                task.wait(0.5)
            end
        else
            task.wait(0.5)
        end
    end
end)
