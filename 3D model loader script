local function registerVehicleFromSeat()
    local char = player.Character
    local humanoid = char and char:FindFirstChild("Humanoid")
    local seat = humanoid and humanoid.SeatPart

    if seat then
        activeVehicleSeat = seat
        knownVehicleParts[seat] = true
        for _, p in ipairs(seat:GetConnectedParts(true)) do
            if p:IsA("BasePart") then
                knownVehicleParts[p] = true
            end
        end
        return true
    end
    return false
end

-- Layer Scanner Loop
local scanTask = task.spawn(function()
    local SCAN_BATCH_SIZE = 40 
    local SCAN_STEP_DELAY = 0.03
    
    while isAlive do
        if #activeLines > 0 and not isBuilding then
            local overlapParams = OverlapParams.new()
            local filterList = {player.Character, workspace:FindFirstChild(FOLDER_NAME)}
            overlapParams.FilterDescendantsInstances = filterList
            overlapParams.FilterType = Enum.RaycastFilterType.Exclude
            
            for i = 1, #activeLines do
                if not isAlive then break end
                local line = activeLines[i]
                if not line then continue end
                
                local isFilled = false
                local detectedPart = nil
                
                pcall(function()
                    local parts = workspace:GetPartBoundsInBox(line.cframe, Vector3.new(lineThickness, lineThickness, line.rounded - 0.1), overlapParams)
                    for _, p in ipairs(parts) do
                        if p:IsA("BasePart") and p.Anchored then
                            local sx, sy, sz = p.Size.X, p.Size.Y, p.Size.Z
                            local matchCount = 0
                            local tol = 0.15
                            if math.abs(sx - lineThickness) <= tol then matchCount = matchCount + 1 end
                            if math.abs(sy - lineThickness) <= tol then matchCount = matchCount + 1 end
                            if math.abs(sz - lineThickness) <= tol then matchCount = matchCount + 1 end
                            local pMax = math.max(sx, sy, sz)
                            if matchCount >= 2 and math.abs(pMax - line.rounded) < 0.2 and (p.Position - line.cframe.Position).Magnitude < (lineThickness * 1.5) then
                                isFilled = true
                                detectedPart = p
                                break
                            end
                        end
                    end
                end)
                
                if line.isFilled ~= isFilled then
                    line.isFilled = isFilled
                    if line.priority then
                        removePriorityLine(line)
                    end
                end
                line.detectedPart = detectedPart
                
                if line.refPart and line.refPart.Parent then
                    if isFilled then
                        line.refPart.Transparency = 1
                    elseif line.occupiedBlock then
                        line.refPart.Transparency = 0.8
                    else
                        line.refPart.Transparency = 0.4
                    end
                end
                if i % SCAN_BATCH_SIZE == 0 then task.wait(SCAN_STEP_DELAY) end
            end
            
            -- Face Guides alignment
            if fillMode then
                for _, face in ipairs(activeFaces) do
                    local filledLines = {}
                    for _, line in ipairs(face.lines) do
                        if line.isFilled and line.detectedPart then
                            table.insert(filledLines, line)
                        end
                    end
                    
                    local center = face.defaultCenter
                    local edge1 = face.defaultEdge
                    local normal = face.originalNormal
                    
                    if #filledLines > 0 then
                        local rawEdge = (filledLines[1].worldP2 - filledLines[1].worldP1).Unit
                        edge1 = (rawEdge - normal * rawEdge:Dot(normal)).Unit
                        
                        if #filledLines >= 2 then
                            local uniquePoints = {}
                            local function addPoint(p)
                                for _, existing in ipairs(uniquePoints) do
                                    if (existing.pos - p).Magnitude < 0.01 then
                                        existing.count = existing.count + 1
                                        return
                                    end
                                end
                                table.insert(uniquePoints, {pos = p, count = 1})
                            end
                            
                            for _, line in ipairs(filledLines) do
                                addPoint(line.worldP1)
                                addPoint(line.worldP2)
                            end
                            
                            local extremities = {}
                            for _, pt in ipairs(uniquePoints) do
                                if pt.count == 1 then table.insert(extremities, pt.pos) end
                            end
                            
                            if #filledLines == 2 and #extremities == 2 then
                                center = (extremities[1] + extremities[2]) / 2
                            else
                                center = Vector3.new(0,0,0)
                                for _, pt in ipairs(uniquePoints) do center += pt.pos end
                                center /= #uniquePoints
                            end
                            
                            local offset = center - face.defaultCenter
                            local distFromPlane = offset:Dot(normal)
                            center = center - (normal * distFromPlane)
                        end
                    end
                    
                    if face.guidePart then
                        local backVector = edge1:Cross(normal).Unit
                        face.guidePart.CFrame = CFrame.fromMatrix(center, edge1, normal, backVector)
                        face.guidePart.Transparency = 0.5
                    end
                end
            else
                for _, face in ipairs(activeFaces) do
                    if face.guidePart then face.guidePart.Transparency = 1 end
                end
            end
            
            refreshPaletteUI()
            task.wait(0.1)
        else
            task.wait(0.5)
        end
    end
end)
registerCleanup(scanTask)

-- Safe Dispatch & Staging Engine
local detachedMoverConnection = RunService.Heartbeat:Connect(function()
    if not isAlive or not isAutoMoveOn then return end
    
    boostNetworkOwnership()
    
    local char = player.Character
    local humanoid = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if humanoid and humanoid.SeatPart then
        registerVehicleFromSeat()
    end
    
    if not activeVehicleSeat or not activeVehicleSeat.Parent or not hrp then
        return
    end
    
    -- Get current welded assembly connected to active vehicle seat
    local activeVehicleSet = {}
    activeVehicleSet[activeVehicleSeat] = true
    for _, p in ipairs(activeVehicleSeat:GetConnectedParts(true)) do
        activeVehicleSet[p] = true
    end
    
    -- Step 1: Ingest newly detached blocks & prevent collisions
    for part, _ in pairs(knownVehicleParts) do
        if part and part.Parent and part:IsA("BasePart") and not part.Anchored then
            if not activeVehicleSet[part] and (not char or not part:IsDescendantOf(char)) then
                if not activePlacedBlocks[part] and not stagingQueueBlocks[part] then
                    part.CanCollide = false -- Protect from colliding & flinging into the void!
                    
                    local sx, sy, sz = part.Size.X, part.Size.Y, part.Size.Z
                    local blockMaxDim = math.max(sx, sy, sz)
                    local roundedMaxDim = math.ceil(blockMaxDim * 2) / 2
                    
                    local bp = Instance.new("BodyPosition")
                    bp.Name = "BuilderAutoMovePos"
                    bp.MaxForce = Vector3.new(1e8, 1e8, 1e8)
                    bp.P = 20000
                    bp.D = 800
                    bp.Parent = part
                    
                    local bg = Instance.new("BodyGyro")
                    bg.Name = "BuilderAutoMoveGyro"
                    bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
                    bg.P = 20000
                    bg.D = 800
                    bg.Parent = part
                    
                    local destroyConn
                    destroyConn = part.AncestryChanged:Connect(function()
                        if not part:IsDescendantOf(workspace) then
                            if destroyConn then destroyConn:Disconnect() end
                            if bp then bp:Destroy() end
                            if bg then bg:Destroy() end
                            stagingQueueBlocks[part] = nil
                        end
                    end)
                    
                    stagingQueueBlocks[part] = {
                        bp = bp,
                        bg = bg,
                        destroyConn = destroyConn,
                        size = part.Size,
                        rounded = roundedMaxDim
                    }
                end
            end
        elseif not part or not part.Parent then
            knownVehicleParts[part] = nil
        end
    end
    
    -- Step 2: Feed Queued Blocks into Free Outline Slots
    for block, queueData in pairs(stagingQueueBlocks) do
        if not block.Parent or block.Anchored then
            if queueData.destroyConn then queueData.destroyConn:Disconnect() end
            if queueData.bp then queueData.bp:Destroy() end
            if queueData.bg then queueData.bg:Destroy() end
            stagingQueueBlocks[block] = nil
        else
            local targetLine = nil
            
            -- Priority first, then standard
            for _, line in ipairs(activeLines) do
                if line.priority and line.rounded == queueData.rounded and not line.isFilled and not line.occupiedBlock then
                    targetLine = line
                    break
                end
            end
            
            if not targetLine then
                for _, line in ipairs(activeLines) do
                    if line.rounded == queueData.rounded and not line.isFilled and not line.occupiedBlock then
                        targetLine = line
                        break
                    end
                end
            end
            
            if targetLine then
                -- Promote from Staging Queue -> Active Placed Outline
                stagingQueueBlocks[block] = nil
                targetLine.occupiedBlock = block
                
                local sx, sy, sz = queueData.size.X, queueData.size.Y, queueData.size.Z
                local targetBlockCFrame = targetLine.cframe
                if sx > sy and sx > sz then 
                    targetBlockCFrame = targetBlockCFrame * CFrame.Angles(0, math.rad(90), 0)
                elseif sy > sx and sy > sz then 
                    targetBlockCFrame = targetBlockCFrame * CFrame.Angles(math.rad(90), 0, 0) 
                end
                
                queueData.bp.Position = targetBlockCFrame.Position
                queueData.bg.CFrame = targetBlockCFrame
                
                local anchorConn
                local destroyConn = queueData.destroyConn
                
                local function cleanPlacement()
                    if anchorConn then anchorConn:Disconnect() end
                    if destroyConn then destroyConn:Disconnect() end
                    if queueData.bp then queueData.bp:Destroy() end
                    if queueData.bg then queueData.bg:Destroy() end
                    if targetLine.occupiedBlock == block then
                        targetLine.occupiedBlock = nil
                    end
                    activePlacedBlocks[block] = nil
                end
                
                anchorConn = block:GetPropertyChangedSignal("Anchored"):Connect(function()
                    if block.Anchored then
                        targetLine.isFilled = true
                        targetLine.detectedPart = block
                        if targetLine.refPart then targetLine.refPart.Transparency = 1 end
                        if targetLine.priority then removePriorityLine(targetLine) end
                        
                        cleanPlacement()
                        refreshPaletteUI()
                        setStatus("Block Anchored! Feeding queue...", Color3.fromRGB(0, 255, 120))
                    end
                end)
                
                destroyConn = block.AncestryChanged:Connect(function()
                    if not block:IsDescendantOf(workspace) then
                        cleanPlacement()
                    end
                end)
                
                activePlacedBlocks[block] = {
                    lineData = targetLine,
                    bp = queueData.bp,
                    bg = queueData.bg,
                    conn = anchorConn,
                    destroyConn = destroyConn
                }
            end
        end
    end
    
    -- Step 3: Manage the Staging Area / Holding Bay for remaining surplus blocks
    local stagingBasePos = hrp.Position + (hrp.CFrame.RightVector * 18) + Vector3.new(0, 10, 0)
    local queueIndex = 0
    
    for block, queueData in pairs(stagingQueueBlocks) do
        queueIndex = queueIndex + 1
        local row = math.floor((queueIndex - 1) / 8)
        local col = (queueIndex - 1) % 8
        local hoverPos = stagingBasePos + (hrp.CFrame.LookVector * (row * 3)) + (hrp.CFrame.RightVector * (col * 3))
        
        queueData.bp.Position = hoverPos
        queueData.bg.CFrame = hrp.CFrame
    end
    
    -- Step 4: Status updates
    local placedCount = 0
    for _ in pairs(activePlacedBlocks) do placedCount = placedCount + 1 end
    
    if queueIndex > 0 then
        setStatus(string.format("[%d Placed | %d Queued] Anchor blocks!", placedCount, queueIndex), Color3.fromRGB(255, 200, 0))
    elseif placedCount > 0 then
        setStatus(string.format("[%d Placed] Anchor to register!", placedCount), Color3.fromRGB(0, 255, 120))
    end
end)
registerCleanup(detachedMoverConnection)

-- ============================================================================
-- CLEANUP HANDLER
-- ============================================================================
local function cleanup()
    isAlive = false
    isAutoMoveOn = false
    
    clearReference()
    clearAllPriorityLines()
    clearAllTrackedBlocks()
    
    for _, item in ipairs(cleanupTasks) do
        pcall(function()
            if typeof(item) == "RBXScriptConnection" then
                item:Disconnect()
            elseif typeof(item) == "Instance" then
                item:Destroy()
            elseif type(item) == "thread" then
                task.cancel(item)
            elseif type(item) == "function" then
                item()
            end
        end)
    end
    table.clear(cleanupTasks)

    if genv.BuilderAutoMove_Cleanup == cleanup then
        genv.BuilderAutoMove_Cleanup = nil
    end
end

genv.BuilderAutoMove_Cleanup = cleanup

