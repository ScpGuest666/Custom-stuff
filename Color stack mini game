local function rebuildCylinders()
    for _, conn in ipairs(activeTubeConnections) do
        conn:Disconnect()
    end
    table.clear(activeTubeConnections)
    cylinderStage:ClearAllChildren()

    tubeButtons = {}
    tubeSlots = {}
    selectedTube = nil

    local cfg = LAYOUT_CONFIG[currentMode]

    for i = 1, currentMode do
        local r = (cfg.rows == 1) and 1 or (i <= cfg.cols and 1 or 2)
        local c = (cfg.rows == 1) and (i - 1) or ((i - 1) % cfg.cols)
        local xPos = cfg.startX + (c * (cfg.tubeWidth + cfg.gapX))
        local yPos = cfg.rowY[r]

        local tubeFrame = Instance.new("TextButton")
        tubeFrame.Name = "Tube_" .. i
        tubeFrame.Parent = cylinderStage
        tubeFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
        tubeFrame.BorderSizePixel = 1
        tubeFrame.BorderColor3 = Color3.fromRGB(70, 70, 85)
        tubeFrame.Size = UDim2.new(0, cfg.tubeWidth, 0, cfg.tubeHeight)
        tubeFrame.Position = UDim2.new(0, xPos, 0, yPos)
        tubeFrame.Text = ""
        tubeFrame.AutoButtonColor = false

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = tubeFrame

        tubeButtons[i] = tubeFrame
        tubeSlots[i] = {}

        for slot = 1, currentMode do
            local block = Instance.new("Frame")
            block.Name = "Block_" .. slot
            block.Parent = tubeFrame
            block.Size = UDim2.new(0, cfg.tubeWidth - 6, 0, cfg.blockH)
            local yOffset = cfg.tubeHeight - (slot * cfg.blockStep) - 2
            block.Position = UDim2.new(0, 3, 0, yOffset)
            block.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            block.Visible = false

            local bCorner = Instance.new("UICorner")
            bCorner.CornerRadius = UDim.new(0, 4)
            bCorner.Parent = block

            tubeSlots[i][slot] = block
        end

        local conn = tubeFrame.MouseButton1Click:Connect(function()
            onTubeClicked(i)
        end)
        table.insert(activeTubeConnections, conn)
    end
end

local function updateVisuals()
    local cfg = LAYOUT_CONFIG[currentMode]
    for i = 1, currentMode do
        local isSelected = (selectedTube == i)
        tubeButtons[i].BorderColor3 = isSelected and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(70, 70, 85)
        for slot = 1, currentMode do
            local block = tubeSlots[i][slot]
            local val = tubes[i] and tubes[i][slot]
            if val then
                block.BackgroundColor3 = COLOR_PALETTE[val] or Color3.fromRGB(150, 150, 150)
                block.Visible = true
                if isSelected and slot == #tubes[i] then
                    block.Position = UDim2.new(0, 3, 0, cfg.hoverY)
                else
                    local yOffset = cfg.tubeHeight - (slot * cfg.blockStep) - 2
                    block.Position = UDim2.new(0, 3, 0, yOffset)
                end
            else
                block.Visible = false
            end
        end
    end
end

local function isGameWon(checkTubes)
    local st = checkTubes or tubes
    local numColors = currentMode - 1
    local completed = 0
    for i = 1, currentMode do
        local t = st[i]
        if #t == currentMode then
            local base = t[1]
            local match = true
            for s = 2, currentMode do
                if t[s] ~= base then
                    match = false
                    break
                end
            end
            if match then
                completed = completed + 1
            else
                return false
            end
        elseif #t ~= 0 then
            return false
        end
    end
    return completed == numColors
end

local function getScore(moves, timeTaken)
    local base = currentMode * 3200
    return math.max(100, math.floor(base - (moves * 25) - (timeTaken * 15)))
end

local function updateStatsDisplay()
    local curTime = isGameActive and (os.clock() - startTime) or elapsedTime
    local pts = getScore(moveCount, curTime)
    statsLabel.Text = string.format("Moves: %d | Time: %.1fs | Pts: %d", moveCount, curTime, pts)
end

local function stopTimer()
    if timerThread then
        task.cancel(timerThread)
        timerThread = nil
    end
    if isGameActive then
        elapsedTime = os.clock() - startTime
        isGameActive = false
    end
end

local function startTimer()
    if isGameActive then return end
    isGameActive = true
    startTime = os.clock() - elapsedTime
    
    if timerThread then task.cancel(timerThread) end
    timerThread = task.spawn(function()
        while isAlive and isGameActive do
            updateStatsDisplay()
            task.wait(0.1)
        end
    end)
    registerCleanup(timerThread)
end

-- ============================================================================
-- DYNAMIC REVERSE-WALK RANDOMIZER (TRUE VARIABLE HEIGHTS & SPACES)
-- ============================================================================
local function randomizeGame()
    if isSolving then return end
    stopTimer()

    selectedTube = nil
    moveCount = 0
    elapsedTime = 0
    isGameActive = false

    local numColors = currentMode - 1
    local capacity = currentMode

    -- 1. Start from a fully completed target state
    tubes = {}
    for c = 1, numColors do
        tubes[c] = {}
        for _ = 1, capacity do
            table.insert(tubes[c], c)
        end
    end
    tubes[currentMode] = {} -- Initial buffer cylinder

    -- 2. Scramble via random legal reverse moves (guarantees solvability)
    local walkSteps = math.random(currentMode * 12, currentMode * 22)
    local lastMove = nil

    for _ = 1, walkSteps do
        local validMoves = {}
        for i = 1, currentMode do
            if #tubes[i] > 0 then
                for j = 1, currentMode do
                    if i ~= j and #tubes[j] < capacity then
                        if not lastMove or lastMove[1] ~= j or lastMove[2] ~= i then
                            table.insert(validMoves, {i, j})
                        end
                    end
                end
            end
        end

        if #validMoves == 0 then break end

        local chosen = validMoves[math.random(1, #validMoves)]
        local block = table.remove(tubes[chosen[1]])
        table.insert(tubes[chosen[2]], block)
        lastMove = chosen
    end

    -- 3. Ensure every cylinder has blocks (no cylinder is left emptied)
    for i = 1, currentMode do
        if #tubes[i] == 0 then
            for j = 1, currentMode do
                if #tubes[j] > 1 then
                    table.insert(tubes[i], table.remove(tubes[j]))
                    break
                end
            end
        end
    end

    -- 4. Shuffle tube ordering so heights and free spaces vary completely
    for i = currentMode, 2, -1 do
        local j = math.random(1, i)
        tubes[i], tubes[j] = tubes[j], tubes[i]
    end

    -- 5. Randomly remap colors to remove any fixed color distribution
    local colorMap = {}
    for c = 1, numColors do
        table.insert(colorMap, c)
    end
    for i = numColors, 2, -1 do
        local j = math.random(1, i)
        colorMap[i], colorMap[j] = colorMap[j], colorMap[i]
    end
    for i = 1, currentMode do
        for k = 1, #tubes[i] do
            tubes[i][k] = colorMap[tubes[i][k]]
        end
    end

    updateVisuals()
    updateStatsDisplay()
end

-- ============================================================================
-- MANUAL MOVES
-- ============================================================================
onTubeClicked = function(index)
    if isSolving or isGameWon() then return end

    if not selectedTube then
        if #tubes[index] > 0 then
            selectedTube = index
            updateVisuals()
        end
    else
        if selectedTube == index then
            selectedTube = nil
            updateVisuals()
        else
            if #tubes[index] < currentMode then
                if not isGameActive then
                    startTimer()
                end

                local block = table.remove(tubes[selectedTube])
                table.insert(tubes[index], block)
                moveCount = moveCount + 1
                selectedTube = nil
                updateVisuals()
                updateStatsDisplay()

                if isGameWon() then
                    stopTimer()
                    local finalScore = getScore(moveCount, elapsedTime)
                    statsLabel.Text = string.format("Solved! Moves: %d | Time: %.1fs | Pts: %d", moveCount, elapsedTime, finalScore)
                end
            else
                if #tubes[index] > 0 then
                    selectedTube = index
                    updateVisuals()
                end
            end
        end
    end
end

