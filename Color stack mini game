local getgenv = getgenv or function() return _G end
local genv = getgenv()

if genv.MyScript_Cleanup and type(genv.MyScript_Cleanup) == "function" then
    pcall(genv.MyScript_Cleanup)
    genv.MyScript_Cleanup = nil
end

local cleanupTasks = {}
local isAlive = true

local function registerCleanup(item)
    table.insert(cleanupTasks, item)
    return item
end

local function cleanup()
    isAlive = false
    for _, item in ipairs(cleanupTasks) do
        pcall(function()
            if typeof(item) == "RBXScriptConnection" then
                item:Disconnect()
            elseif typeof(item) == "Instance" then
                item:Destroy()
            elseif type(item) == "thread" then
                task.cancel(item)
            elseif type(item) == "function" then
                item()
            end
        end)
    end
    table.clear(cleanupTasks)
    if genv.MyScript_Cleanup == cleanup then
        genv.MyScript_Cleanup = nil
    end
end

genv.MyScript_Cleanup = cleanup

