-- Function to extract names of eggs shown in the Index GUI (specifically "x... In Map")
local function getIndexEggNames()
    local names = {}
    local pGui = player:FindFirstChild("PlayerGui")
    if not pGui then return names end

    for _, desc in ipairs(pGui:GetDescendants()) do
        if desc:IsA("TextLabel") and string.find(string.lower(desc.Text), "in map") then
            local card = desc.Parent
            local detectedName = nil

            -- 1. Try card container name
            if card and card.Name and not string.match(card.Name, "^Frame") and not string.match(card.Name, "^Template") and not string.match(card.Name, "^Slot") then
                detectedName = card.Name
            end

            -- 2. Try attributes or StringValues
            if card and not detectedName then
                for attrKey, attrVal in pairs(card:GetAttributes()) do
                    if type(attrVal) == "string" and string.find(string.lower(attrKey), "name") then
                        detectedName = attrVal
                        break
                    end
                end
                for _, child in ipairs(card:GetChildren()) do
                    if child:IsA("StringValue") and string.find(string.lower(child.Name), "name") then
                        detectedName = child.Value
                        break
                    end
                end
            end

            -- 3. Try reading label text on the card (excluding currency/multipliers)
            if card and not detectedName then
                for _, child in ipairs(card:GetDescendants()) do
                    if child:IsA("TextLabel") and child ~= desc then
                        local t = child.Text
                        if not string.match(t, "^%s*[%$]?[%d%.]+%s*[kKmMbBtTqQ]?%s*$") and not string.find(string.lower(t), "in map") and #t > 1 then
                            detectedName = t
                            break
                        end
                    end
                end
            end

            if detectedName and detectedName ~= "" then
                table.insert(names, string.lower(detectedName))
            end
        end
    end

    return names
end

local function applyHighlight(targetInstance, rootPart, displayName, color)
    local hl = Instance.new("Highlight")
    hl.Name = "SearchHighlight"
    hl.Adornee = targetInstance
    hl.FillColor = color
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.4
    hl.OutlineTransparency = 0
    hl.Parent = targetInstance
    table.insert(activeHighlights, hl)

    local bb = Instance.new("BillboardGui")
    bb.Name = "SearchBillboard"
    bb.Adornee = rootPart
    bb.Size = UDim2.new(0, 130, 0, 32)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.AlwaysOnTop = true

    local label = Instance.new("TextLabel")
    label.Parent = bb
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1

    -- Distance display calculation
    local dist = 0
    if player.Character and player.Character.PrimaryPart then
        dist = math.floor((player.Character.PrimaryPart.Position - rootPart.Position).Magnitude)
    end

    label.Text = displayName .. " [" .. dist .. "m]"
    label.TextColor3 = color
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextScaled = true

    bb.Parent = targetInstance
    table.insert(activeHighlights, bb)
end

local function updateSearch()
    clearHighlights()
    if not isOnline then return end

    local char = player.Character

    if currentMode == "search" then
        if currentSearchQuery == "" then return end
        local query = string.lower(currentSearchQuery)

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if not isOnline or currentMode ~= "search" then break end
            if char and (obj == char or obj:IsDescendantOf(char)) then continue end

            if string.find(string.lower(obj.Name), query, 1, true) then
                local targetInstance = nil
                local rootPart = nil

                if obj:IsA("Model") then
                    targetInstance = obj
                    rootPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                elseif obj:IsA("BasePart") and not (obj.Parent and obj.Parent:IsA("Model") and string.find(string.lower(obj.Parent.Name), query, 1, true)) then
                    targetInstance = obj
                    rootPart = obj
                end

                if targetInstance and rootPart then
                    applyHighlight(targetInstance, rootPart, obj.Name, Color3.fromRGB(255, 220, 0))
                end
            end
        end

    elseif currentMode == "index" then
        local indexEggNames = getIndexEggNames()

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if not isOnline or currentMode ~= "index" then break end
            if char and (obj == char or obj:IsDescendantOf(char)) then continue end

            local objName = string.lower(obj.Name)
            local isMatch = false

            -- Match by names identified from Index UI
            if #indexEggNames > 0 then
                for _, name in ipairs(indexEggNames) do
                    if string.find(objName, name, 1, true) or string.find(name, objName, 1, true) then
                        isMatch = true
                        break
                    end
                end
            else
                -- Fallback: Highlight any spawned egg in map if Index UI hasn't loaded text
                if string.find(objName, "egg", 1, true) then
                    isMatch = true
                end
            end

            if isMatch then
                local targetInstance = nil
                local rootPart = nil

                if obj:IsA("Model") then
                    targetInstance = obj
                    rootPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                elseif obj:IsA("BasePart") and not (obj.Parent and obj.Parent:IsA("Model") and string.find(string.lower(obj.Parent.Name), "egg", 1, true)) then
                    targetInstance = obj
                    rootPart = obj
                end

                if targetInstance and rootPart then
                    applyHighlight(targetInstance, rootPart, "[Index] " .. obj.Name, Color3.fromRGB(0, 255, 200))
                end
            end
        end
    end
end

-- Refresh loop to detect new spawns and update markers
local refreshThread = task.spawn(function()
    while isAlive do
        if isOnline then
            updateSearch()
        end
        task.wait(3)
    end
end)
registerCleanup(refreshThread)

