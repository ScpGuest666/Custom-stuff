-- ============================================================================
-- UNIVERSAL DRAG HANDLER (Works on both PC & Mobile for Status Bar & Main Frame)
-- ============================================================================
local function makeDraggable(handle, frameToMove)
    local dragging = false
    local dragStart = nil
    local startPos = nil

    registerCleanup(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frameToMove.Position

            local endCon
            endCon = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    endCon:Disconnect()
                end
            end)
            registerCleanup(endCon)
        end
    end))

    registerCleanup(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frameToMove.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end))
end

-- Allow dragging by grabbing either the status bar or the main frame body
makeDraggable(status, mainFrame)
makeDraggable(mainFrame, mainFrame)

