local function isIgnorablePart(part)
    if not part:IsA("BasePart") then return true end
    if part:IsDescendantOf(customFolder) then return true end
    if part:FindFirstChildOfClass("ParticleEmitter") or part:FindFirstChildOfClass("Fire") then return true end
    if part.Transparency >= 1 then return true end
    
    local name = part.Name:lower()
    if name:find("cube") or name:find("grey") or name:find("decoration") or 
       name:find("pocket") or name:find("hole") or name:find("marker") or name:find("effect") or name:find("hitbox") then
        return true
    end
    local parent = part.Parent
    if parent then
        local pName = parent.Name:lower()
        if pName:find("cube") or pName:find("grey") or pName:find("decoration") or
           pName:find("pocket") or pName:find("hole") or pName:find("marker") or pName:find("effect") or pName:find("hitbox") then
            return true
        end
    end
    local size = part.Size
    if size.X < 2.5 and size.Y < 2.5 and size.Z < 2.5 then
        if part:IsA("Part") and part.Shape == Enum.PartType.Block and not part:FindFirstChildOfClass("SpecialMesh") then
            return true
        end
    end
    local c = part.Color
    local r, g, b = c.R*255, c.G*255, c.B*255
    if r >= 100 and r <= 150 and g >= 100 and g <= 150 and b >= 100 and b <= 150 then
        local diff = math.abs(r-g) + math.abs(g-b) + math.abs(b-r)
        if diff < 30 then return true end
    end
    return false
end

local function isBall(obj)
    if not obj:IsA("BasePart") then return false end
    if obj:IsDescendantOf(customFolder) then return false end
    if obj.Size.Magnitude > 5 then return false end
    if obj:FindFirstChildOfClass("ParticleEmitter") or obj:FindFirstChildOfClass("Fire") then return false end
    
    local name = obj.Name:lower()
    if name:find("cyan") or name:find("fake") or name:find("effect") or name:find("hitbox") then return false end
    if obj.Color == Color3.fromRGB(0, 255, 255) then return false end
    
    if obj:IsA("Part") and obj.Shape == Enum.PartType.Block then
        if not obj:FindFirstChildOfClass("SpecialMesh") then return false end
    end
    
    if name:find("ball") or name == "cue" or name == "white" then return true end
    local num = tonumber(obj.Name)
    if num and num >= 1 and num <= 15 then return true end
    if obj:IsA("Part") and obj.Shape == Enum.PartType.Ball then return true end
    
    if math.abs(obj.Size.X - obj.Size.Y) < 0.01 and math.abs(obj.Size.Y - obj.Size.Z) < 0.01 then
        return true
    end
    return false
end

local function isCueStick(obj)
    if not obj:IsA("BasePart") then return false end
    if obj.Size.Magnitude <= 2.5 then return false end
    local name = obj.Name:lower()
    local parentName = obj.Parent and obj.Parent.Name:lower() or ""
    
    local isNamedCue = (name:find("cue") or name:find("stick") or name:find("aim") or name:find("heartseeker") or 
                        parentName:find("cue") or parentName:find("stick") or parentName:find("heartseeker"))
                        
    if not isNamedCue then return false end
    local isNotBall = not (name:find("ball") or parentName:find("ball"))
    if not isNotBall then return false end
    local parent = obj.Parent
    while parent and parent ~= workspace do
        if parent:FindFirstChildOfClass("Humanoid") then return false end
        parent = parent.Parent
    end
    return true
end

local function getBallInfo(ball)
    local name = ball.Name:lower()
    local num = tonumber(ball.Name)
    if name:find("cue") or name == "white" or name == "0" then return Color3.fromRGB(255, 255, 255) end
    if num then
        if num == 8 then 
            local pulseAlpha = (math.sin(os.clock() * 6) + 1) / 2
            return Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(255, 255, 0), pulseAlpha)
        elseif num >= 1 and num <= 7 then return Color3.fromRGB(255, 50, 50)
        elseif num >= 9 and num <= 15 then return Color3.fromRGB(255, 255, 50)
        end
    end
    return Color3.fromRGB(0, 255, 255)
end

local function isCueBall(ball)
    return getBallInfo(ball) == Color3.fromRGB(255, 255, 255)
end

local function refreshCache()
    local tempBalls, tempSticks, tempTables = {}, {}, {}
    local count = 0
    local descendants = workspace:GetDescendants()
    for i = 1, #descendants do
        local obj = descendants[i]
        if isBall(obj) then table.insert(tempBalls, obj)
        elseif isCueStick(obj) then table.insert(tempSticks, obj) 
        elseif obj.Name == "Model" and obj:IsA("Model") then
            local parentName = obj.Parent and obj.Parent.Name
            if parentName == "1" or parentName == "2" or parentName == "3" or parentName == "4" or parentName == "5" or parentName == "6" then
                table.insert(tempTables, obj)
            end
        end
        count = count + 1
        if count >= 1500 then count = 0 task.wait() end
    end
    cachedBalls = tempBalls
    cachedSticks = tempSticks
    cachedTables = tempTables
end

