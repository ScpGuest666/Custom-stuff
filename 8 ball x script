-- [[ HELPER: SNAP TO AXIS ]] --
local function getSnappedAxis(vec)
    local absX = math.abs(vec.X)
    local absZ = math.abs(vec.Z)
    if absX > absZ then
        return Vector3.new(math.sign(vec.X), 0, 0)
    else
        return Vector3.new(0, 0, math.sign(vec.Z))
    end
end

