local function drawGhostLine(startPos, direction, length, color, tableY, material, transparency)
    local flatStart = Vector3.new(startPos.X, tableY, startPos.Z)
    local flatEnd = flatStart + direction * length
    local dist = length
    if dist < 0.01 then return end
    local linePart = Instance.new("Part")
    linePart.Anchored = true
    linePart.CanCollide = false
    linePart.CanQuery = false
    linePart.Size = Vector3.new(0.12, 0.12, dist)
    linePart.CFrame = CFrame.lookAt(flatStart + (flatEnd - flatStart)/2, flatEnd)
    linePart.Color = color
    linePart.Material = material or Enum.Material.Neon
    linePart.Transparency = transparency or 0
    linePart.Parent = workspace
    table.insert(ghostLines, linePart)
end

local function getBallIntersection(rayOrigin, rayDir, ballRadius, tableY, ignoreBall)
    local closestDist = math.huge
    local closestBall = nil
    local flatOrigin = rayOrigin * Vector3.new(1, 0, 1)
    for _, ball in ipairs(cachedBalls) do
        if ball ~= ignoreBall and ball.Parent then
            if math.abs(ball.Position.Y - tableY) < 0.8 then
                local flatBallPos = ball.Position * Vector3.new(1, 0, 1)
                local L = flatBallPos - flatOrigin
                local tca = L:Dot(rayDir)
                if tca > 0 then
                    local d2 = L:Dot(L) - tca * tca
                    local radius2 = (ballRadius * 2) ^ 2
                    if d2 <= radius2 then
                        local thc = math.sqrt(radius2 - d2)
                        local t0 = tca - thc
                        if t0 > 0 and t0 < closestDist then
                            closestDist = t0
                            closestBall = ball
                        end
                    end
                end
            end
        end
    end
    return closestBall, closestDist
end

-- [[ MAIN COMBINED PREDICTION & EXTENSION LOOP ]] --
local function updateHighlights()
    if not isHighlighting then return end
    
    forceBallsVisible()
    
    local now = tick()
    local rainbowColor = Color3.fromHSV((now * 1.5) % 1, 1, 1)

    -- 1. Scan and highlight the 6 Cushion Rails in Rainbow
    if now - lastWallScan > 0.4 or #cachedCushionWalls < 6 then
        lastWallScan = now
        cachedCushionWalls = getClosest6CushionWalls()
    end

    for _, wall in ipairs(cachedCushionWalls) do
        if wall and wall.Parent then
            saveOriginal(wall)
            pcall(function()
                wall.Color = rainbowColor
                wall.Material = Enum.Material.Neon
            end)
        end
    end

    -- 2. Check for In-Game Trajectory Elements (TrajectoryViz)
    local trajViz = Workspace:FindFirstChild("TrajectoryViz") or (Workspace.CurrentCamera and Workspace.CurrentCamera:FindFirstChild("TrajectoryViz"))
    local inGameHookUsed = false
    local extLineCount = 0

    if trajViz then
        local inGameMainLine = nil
        local inGameDeflectParts = {}
        local inGameGhostMarker = nil

        for _, child in ipairs(trajViz:GetDescendants()) do
            if child:IsA("BasePart") and child.Transparency < 0.95 then
                saveOriginal(child)
                pcall(function()
                    child.Color = GOLD_COLOR
                    child.Material = Enum.Material.Neon
                end)

                local name = string.lower(child.Name)
                if string.find(name, "main") then
                    inGameMainLine = child
                elseif string.find(name, "deflect") or string.find(name, "bounce") then
                    table.insert(inGameDeflectParts, child)
                elseif string.find(name, "cylinder") or string.find(name, "ghost") or string.find(name, "circle") then
                    inGameGhostMarker = child
                end
            end
        end

        local hookImpactPos = inGameGhostMarker and inGameGhostMarker.Position or nil
        if inGameMainLine then
            local mSize = inGameMainLine.Size
            local mCf = inGameMainLine.CFrame
            local mDir = mCf.LookVector
            local mLen = mSize.Z
            if mSize.X > mSize.Y and mSize.X > mSize.Z then
                mDir = mCf.RightVector
                mLen = mSize.X
            end
            if not hookImpactPos then
                hookImpactPos = mCf.Position + mDir * (mLen / 2)
            end
        end

        if hookImpactPos then
            -- Find target ball at the ghost ball impact position
            local targetBall = nil
            local minContactDist = 2.5
            for _, ball in ipairs(cachedBalls) do
                if ball and ball.Parent then
                    local distH = (Vector3.new(ball.Position.X, hookImpactPos.Y, ball.Position.Z) - hookImpactPos).Magnitude
                    if distH < minContactDist and distH > 0.05 then
                        minContactDist = distH
                        targetBall = ball
                    end
                end
            end

            -- Extend target ball line of centers
            if targetBall then
                local ballTravelDir = Vector3.new(targetBall.Position.X - hookImpactPos.X, 0, targetBall.Position.Z - hookImpactPos.Z)
                if ballTravelDir.Magnitude > 0.01 then
                    extLineCount = extLineCount + 1
                    drawExtendedRayLine(targetBall.Position, ballTravelDir, extLineCount)
                    inGameHookUsed = true
                end
            end
        end

        -- Extend deflection lines from in-game parts
        for _, defPart in ipairs(inGameDeflectParts) do
            extLineCount = extLineCount + 1
            if projectFromPart(defPart, extLineCount) then
                inGameHookUsed = true
            end
        end
    end

    -- Hide unused custom extension lines
    for i = extLineCount + 1, #customLinePool do
        if customLinePool[i] then
            customLinePool[i].Transparency = 1
        end
    end

    -- 3. Raycast-Based Physics Trajectory Engine
    local camera = workspace.CurrentCamera
    if not camera then return end
    
    local camPos = camera.CFrame.Position
    local camLook = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
    
    if camLook.Magnitude > 0.001 then
        camLook = camLook.Unit
    else
        camLook = nil
    end
    
    if not camLook then
        hideTrajectories()
        clearGhostVisuals()
        return
    end
    
    local activeModel = nil
    local minTableDist = math.huge
    for _, model in ipairs(cachedTables) do
        local part = model:FindFirstChildWhichIsA("BasePart", true)
        if part then
            local dist = (part.Position - camPos).Magnitude
            if dist < minTableDist then
                minTableDist = dist
                activeModel = model
            end
        end
    end
    
    local activeCueBall = nil
    local minCamDist = math.huge
    for _, ball in ipairs(cachedBalls) do
        if isCueBall(ball) and ball.Parent then
            local dist = (ball.Position - camPos).Magnitude
            if dist < minCamDist and dist < 60 then
                minCamDist = dist
                activeCueBall = ball
            end
        end
    end
    
    if not activeCueBall then
        hideTrajectories()
        clearGhostVisuals()
        return
    end
    
    local pullback = 0
    local bestStick = nil
    local minStickDist = 15
    for _, stick in ipairs(cachedSticks) do
        if stick and stick.Parent and stick.Transparency < 0.9 then
            local dist = (stick.Position - activeCueBall.Position).Magnitude
            if dist < minStickDist then
                minStickDist = dist
                bestStick = stick
            end
        end
    end
    
    if bestStick then
        local stickLength = math.max(bestStick.Size.X, bestStick.Size.Y, bestStick.Size.Z)
        local restingDist = (stickLength / 2) + (activeCueBall.Size.X / 2)
        local currentDist = (activeCueBall.Position - bestStick.Position).Magnitude
        pullback = math.max(0, currentDist - restingDist)
    end
    
    local totalDistance
    if pullback > 0 then
        totalDistance = 5 + (pullback * POWER_SCALE)
        totalDistance = math.clamp(totalDistance, 2, 150)
    else
        totalDistance = 30
    end
    
    hideTrajectories()
    clearGhostVisuals()
    
    local tableY = activeCueBall.Position.Y
    local ballRadius = activeCueBall.Size.X / 2
    local aimDir = camLook
    
    local lineIndex = 1
    local maxLinesAllowed = 30
    local firstWallAngle = nil
    local hasDrawnPerpLine = false
    
    local tempUnfoldedStart = nil
    local tempUnfoldedDir = nil
    local tempUnfoldedDist = nil
    
    local function simulatePath(startPos, direction, isCue, ignoreBall, maxBounces, color, remainingDist)
        local currentPos = startPos
        local currentDir = direction
        local currentDistLeft = remainingDist
        
        for bounce = 1, maxBounces do
            if lineIndex > maxLinesAllowed or currentDistLeft <= 0.1 then return end
            
            local hitBall, ballDist = getBallIntersection(currentPos, currentDir, ballRadius, tableY, ignoreBall)
            if hitBall and ballDist > currentDistLeft then hitBall = nil end
            
            local wallHitPos, wallNormal, wallDist = nil, nil, math.huge
            local rayOrigin = Vector3.new(currentPos.X, tableY, currentPos.Z)
            local ignoreList = {player.Character, customFolder}
            if bestStick then table.insert(ignoreList, bestStick) end
            for _, b in ipairs(cachedBalls) do table.insert(ignoreList, b) end
            
            local searchDist = hitBall and ballDist or currentDistLeft
            local currentRayOrigin = rayOrigin
            local safety = 0
            
            while searchDist > 0 and safety < 50 do
                safety = safety + 1
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = ignoreList
                
                local result = workspace:Raycast(currentRayOrigin, currentDir * searchDist, rayParams)
                if result then
                    local inst = result.Instance
                    local isValidHit = true
                    
                    if isIgnorablePart(inst) then
                        isValidHit = false
                    end
                    
                    if isValidHit then
                        if activeModel and not inst:IsDescendantOf(activeModel) then isValidHit = false end
                        if math.abs(result.Normal.Y) > 0.95 then isValidHit = false end
                        if inst.Transparency > 0.9 then isValidHit = false end
                    end
                    
                    if isValidHit then
                        wallHitPos = result.Position
                        
                        local rawNormal = result.Normal * Vector3.new(1, 0, 1)
                        if rawNormal.Magnitude > 0.001 then 
                            wallNormal = rawNormal.Unit
                        else 
                            wallNormal = -currentDir 
                        end
                        
                        local rawDist = (Vector3.new(wallHitPos.X, tableY, wallHitPos.Z) - rayOrigin).Magnitude
                        local dot = currentDir:Dot(wallNormal)
                        local offset = ballRadius
                        if dot < -0.001 then offset = math.min(ballRadius / math.abs(dot), ballRadius * 10) end
                        wallDist = math.max(0, rawDist - offset)
                        break
                    else
                        table.insert(ignoreList, inst)
                    end
                else
                    break
                end
            end
            
            if hitBall and ballDist <= wallDist then
                local impactPos = currentPos + currentDir * ballDist
                
                drawLine(lineIndex, currentPos, impactPos, color, tableY)
                lineIndex = lineIndex + 1
                drawGhostBall(impactPos, color, tableY, ballRadius)
                local collisionNormal = (hitBall.Position * Vector3.new(1,0,1) - impactPos * Vector3.new(1,0,1)).Unit
                drawGhostLine(impactPos, collisionNormal, 1.5, getBallInfo(hitBall), tableY)
                currentDistLeft = currentDistLeft - ballDist
                if isCue then
                    local impactDot = math.clamp(currentDir:Dot(collisionNormal), 0, 1)
                    local targetDist = currentDistLeft * impactDot * 0.85 
                    local cueDist = currentDistLeft * math.sqrt(1 - (impactDot * impactDot)) * 0.6 
                    
                    simulatePath(hitBall.Position, collisionNormal, false, hitBall, 3, getBallInfo(hitBall), targetDist)
                    
                    local tangent = currentDir - currentDir:Dot(collisionNormal) * collisionNormal
                    if tangent.Magnitude > 0.01 then
                        simulatePath(impactPos + tangent.Unit * 0.05, tangent.Unit, false, hitBall, 1, Color3.fromRGB(150, 150, 255), cueDist)
                    end
                else
                    local impactDot = math.clamp(currentDir:Dot(collisionNormal), 0, 1)
                    local targetDist = currentDistLeft * impactDot * 0.85
                    simulatePath(hitBall.Position, collisionNormal, false, hitBall, 2, getBallInfo(hitBall), targetDist)
                end
                break
                
            elseif wallHitPos and wallDist < math.huge then
                local impactPos = currentPos + currentDir * wallDist
                
                drawLine(lineIndex, currentPos, impactPos, color, tableY)
                lineIndex = lineIndex + 1
                drawGhostBall(impactPos, color, tableY, ballRadius)
                currentDistLeft = currentDistLeft - wallDist
                
                local dot = currentDir:Dot(wallNormal)
                local incomingAngle = math.deg(math.acos(math.abs(dot)))
                
                if not firstWallAngle then
                    firstWallAngle = incomingAngle
                end
                
                -- [[ THE UNFOLDING TRICK ]] --
                if not hasDrawnPerpLine then
                    hasDrawnPerpLine = true
                    
                    tempUnfoldedStart = impactPos
                    tempUnfoldedDir = currentDir
                    tempUnfoldedDist = currentDistLeft
                    
                    local perpDir = getSnappedAxis(-wallNormal)
                    local pathStartFlat = Vector3.new(startPos.X, tableY, startPos.Z)
                    
                    local innerRayParams = RaycastParams.new()
                    innerRayParams.FilterType = Enum.RaycastFilterType.Exclude
                    innerRayParams.FilterDescendantsInstances = ignoreList
                    local innerHit = workspace:Raycast(pathStartFlat, perpDir * 50, innerRayParams)
                    local innerPos = innerHit and innerHit.Position or (pathStartFlat + perpDir * 10)
                    
                    local outerRayOrigin = innerPos + perpDir * 10
                    local outerRayParams = RaycastParams.new()
                    outerRayParams.FilterType = Enum.RaycastFilterType.Include
                    outerRayParams.FilterDescendantsInstances = #cachedCushionWalls > 0 and cachedCushionWalls or {activeModel}
                    local outerHit = workspace:Raycast(outerRayOrigin, -perpDir * 10, outerRayParams)
                    local outerPos = outerHit and outerHit.Position or (innerPos + perpDir * 1.5)
                    
                    drawGhostLine(pathStartFlat, perpDir, (outerPos - pathStartFlat).Magnitude, rainbowColor, tableY, Enum.Material.SmoothPlastic, 0.5)
                    drawGhostBall(outerPos, Color3.fromRGB(200, 200, 200), tableY, ballRadius)
                end
                
                -- [[ PURE MATHEMATICAL REFLECTION ]] --
                local newDir = currentDir - 2 * dot * wallNormal
                currentDir = newDir.Unit
                
                currentPos = impactPos + wallNormal * 0.02 + currentDir * 0.05
                ignoreBall = nil
            else
                local endPos = currentPos + currentDir * currentDistLeft
                drawLine(lineIndex, currentPos, endPos, color, tableY)
                drawGhostBall(endPos, color, tableY, ballRadius) 
                lineIndex = lineIndex + 1
                break
            end
        end
    end
    
    simulatePath(activeCueBall.Position, aimDir, true, activeCueBall, 4, Color3.fromRGB(255, 255, 255), totalDistance)
    
    if tempUnfoldedStart and tempUnfoldedDir then
        unfoldedStartPos = tempUnfoldedStart
        unfoldedDirection = tempUnfoldedDir
        unfoldedDistance = tempUnfoldedDist
    end
    
    -- Status text update
    if inGameHookUsed then
        statusLabel.Text = string.format("Hook Active (%d Ext)", extLineCount)
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    elseif firstWallAngle then
        statusLabel.Text = string.format("Angle: %.1f° (%d Rails)", firstWallAngle, #cachedCushionWalls)
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    else
        statusLabel.Text = string.format("Online | %d Rails Cached", #cachedCushionWalls)
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    end
end

-- [[ BUTTON LOGIC ]] --
calcBtn.MouseButton1Click:Connect(function()
    isCalculating = not isCalculating
    if isCalculating then
        calcBtn.Text = "Calculate: ON"
        calcBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
        
        if unfoldedStartPos and unfoldedDirection and unfoldedDistance then
            calculatedLinePart = Instance.new("Part")
            calculatedLinePart.Anchored = true
            calculatedLinePart.CanCollide = false
            calculatedLinePart.CanQuery = false
            
            local flatStart = Vector3.new(unfoldedStartPos.X, unfoldedStartPos.Y, unfoldedStartPos.Z)
            local flatEnd = flatStart + (unfoldedDirection * unfoldedDistance)
            local dist = unfoldedDistance
            
            if dist > 0.01 then
                calculatedLinePart.Size = Vector3.new(0.12, 0.12, dist)
                calculatedLinePart.CFrame = CFrame.lookAt(flatStart + (flatEnd - flatStart)/2, flatEnd)
                calculatedLinePart.Material = Enum.Material.SmoothPlastic
                calculatedLinePart.Transparency = 0.5
                calculatedLinePart.Parent = workspace
                
                task.spawn(function()
                    while isCalculating and calculatedLinePart and calculatedLinePart.Parent do
                        calculatedLinePart.Color = Color3.fromHSV((os.clock() % 2) / 2, 1, 1)
                        task.wait()
                    end
                end)
            end
        end
    else
        calcBtn.Text = "Calculate: OFF"
        calcBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        if calculatedLinePart then
            calculatedLinePart:Destroy()
            calculatedLinePart = nil
        end
    end
end)

local function setStatusOnline()
    if isHighlighting then return end
    isHighlighting = true
    currentSessionId = currentSessionId + 1
    local thisSession = currentSessionId
    statusLabel.Text = "Status: Online"
    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    
    task.spawn(function()
        refreshCache()
        cachedCushionWalls = getClosest6CushionWalls()
        while isHighlighting and currentSessionId == thisSession do
            task.wait(2)
            if isHighlighting and currentSessionId == thisSession then 
                refreshCache()
                cachedCushionWalls = getClosest6CushionWalls()
            end
        end
    end)
    
    table.insert(activeConnections, RunService.RenderStepped:Connect(updateHighlights))
end

local function setStatusOffline()
    isHighlighting = false
    currentSessionId = currentSessionId + 1
    statusLabel.Text = "Status: Offline"
    statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
    
    clearGhostVisuals()
    hideTrajectories()
    hideAllCustomLines()
    restoreAll()
    
    if isCalculating then
        isCalculating = false
        calcBtn.Text = "Calculate: OFF"
        calcBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        if calculatedLinePart then
            calculatedLinePart:Destroy()
            calculatedLinePart = nil
        end
    end
    
    for _, connection in pairs(activeConnections) do
        if connection and connection.Disconnect then connection:Disconnect() end
    end
    activeConnections = {}
end

local function cleanup()
    setStatusOffline()
    for _, p in pairs(trajectoryParts) do p:Destroy() end
    clearGhostVisuals()
    clearCustomLines()
    if customFolder then customFolder:Destroy() end
    screenGui:Destroy()
end

onBtn.MouseButton1Click:Connect(setStatusOnline)
offBtn.MouseButton1Click:Connect(setStatusOffline)
destroyBtn.MouseButton1Click:Connect(cleanup)
