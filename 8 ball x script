local function drawExtendedRayLine(origin, direction, lineIndex)
    if direction.Magnitude < 0.01 then return false end
    local dirUnit = direction.Unit
    local rayDist = MAX_EXTEND_DIST

    if #cachedCushionWalls > 0 then
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Include
        rayParams.FilterDescendantsInstances = cachedCushionWalls

        local hit = Workspace:Raycast(origin + dirUnit * 0.1, dirUnit * MAX_EXTEND_DIST, rayParams)
        if hit then
            rayDist = (hit.Position - origin).Magnitude
        end
    end

    if rayDist > 0.2 then
        local customLine = getCustomLine(lineIndex)
        customLine.Size = Vector3.new(0.12, 0.12, rayDist)
        customLine.CFrame = CFrame.lookAt(origin + dirUnit * (rayDist / 2), origin + dirUnit * (rayDist + 1))
        customLine.Color = GOLD_COLOR
        customLine.Transparency = 0
        return true
    end
    return false
end

local function projectFromPart(part, lineIndex)
    local size = part.Size
    local cf = part.CFrame
    local dir = cf.LookVector
    local len = size.Z

    if size.X > size.Y and size.X > size.Z then
        dir = cf.RightVector
        len = size.X
    elseif size.Y > size.X and size.Y > size.Z then
        dir = cf.UpVector
        len = size.Y
    end

    if len < 0.15 then return false end
    local startPos = cf.Position - dir * (len / 2)
    return drawExtendedRayLine(startPos, dir, lineIndex)
end

