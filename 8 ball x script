local function saveOriginal(part)
    if originalProperties[part] then return end
    originalProperties[part] = {
        Color = part.Color,
        Material = part.Material
    }
end

local function restorePart(part)
    local props = originalProperties[part]
    if props and part and part.Parent then
        pcall(function()
            part.Color = props.Color
            part.Material = props.Material
        end)
    end
    originalProperties[part] = nil
end

local function restoreAll()
    for part, _ in pairs(originalProperties) do
        restorePart(part)
    end
    table.clear(originalProperties)
    table.clear(cachedCushionWalls)
end

-- [[ CUSHION WALL DETECTION ]] --
local function isCushionWall(obj)
    if not (obj:IsA("UnionOperation") or (obj:IsA("BasePart") and obj.Name == "Union")) then
        return false
    end
    if not (obj.Parent and obj.Parent:IsA("Folder")) then
        return false
    end

    local size = obj.Size
    local minH = math.min(size.X, size.Z)
    local maxH = math.max(size.X, size.Z)

    if minH > 2.0 and maxH > 4.0 then return false end
    if maxH >= 2.5 and minH <= 2.0 and size.Y <= 2.5 then return true end

    return false
end

local function getClosest6CushionWalls()
    local char = player.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
    local refPos = root and root.Position or (Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position)
    if not refPos then return {} end

    local wallCandidates = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isCushionWall(obj) then
            local dist = (obj.Position - refPos).Magnitude
            if dist <= 35 then
                table.insert(wallCandidates, { obj = obj, dist = dist })
            end
        end
    end

    table.sort(wallCandidates, function(a, b) return a.dist < b.dist end)

    local selected = {}
    for i = 1, math.min(#wallCandidates, 6) do
        table.insert(selected, wallCandidates[i].obj)
    end
    return selected
end

