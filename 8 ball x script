-- [[ FILE SYSTEM SETUP (DELTA EXECUTOR) ]] --
local FOLDER_NAME = "Bank data"
local FILE_NAME = FOLDER_NAME .. "/adjustments.json"

local bankData = {}

if isfolder and not isfolder(FOLDER_NAME) then
    pcall(function() makefolder(FOLDER_NAME) end)
end

local function saveBankData()
    if writefile then
        pcall(function()
            local dataToSave = bankData
            local count = 0
            for _ in pairs(dataToSave) do count = count + 1 end
            if count == 0 then dataToSave = {["_init"] = 1.0} end 
            
            writefile(FILE_NAME, HttpService:JSONEncode(dataToSave))
        end)
    end
end

local function loadBankData()
    if isfile and isfile(FILE_NAME) then
        pcall(function()
            local data = HttpService:JSONDecode(readfile(FILE_NAME))
            if data then
                bankData = {}
                local isCorrupted = false
                for k, v in pairs(data) do 
                    if k ~= "_init" then 
                        -- AUTO-FIX: If data is less than 5 degrees (and not angle 0), it's old multiplier data. Wipe it.
                        if tonumber(k) > 10 and v < 5 then
                            isCorrupted = true
                            break
                        end
                        bankData[tostring(k)] = v 
                    end
                end
                if isCorrupted then
                    bankData = {}
                    saveBankData()
                end
            end
        end)
    else
        saveBankData()
    end
end
loadBankData()

-- [[ DYNAMIC INTERPOLATION ENGINE ]] --
local function getBankOutAngle(angle)
    angle = math.clamp(angle, 0, 90)
    
    local points = { [0] = 0, [90] = 90 }
    for k, v in pairs(bankData) do
        local numK = tonumber(k)
        if numK then points[numK] = v end
    end
    
    local keys = {}
    for k, _ in pairs(points) do table.insert(keys, k) end
    table.sort(keys)
    
    local lower, upper
    for i = 1, #keys do
        if keys[i] <= angle then lower = keys[i] end
        if keys[i] >= angle and not upper then upper = keys[i] break end
    end
    
    if lower == upper then return points[lower] end
    
    local lowerVal = points[lower]
    local upperVal = points[upper]
    local alpha = (angle - lower) / (upper - lower)
    
    return lowerVal + (upperVal - lowerVal) * alpha
end

