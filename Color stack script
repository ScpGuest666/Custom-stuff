onTubeClicked = function(index)
    if isSolving or isCopying or isGameWon() then return end

    if not selectedTube then
        if #tubes[index] > 0 then
            selectedTube = index
            updateVisuals()
        end
    else
        if selectedTube == index then
            selectedTube = nil
            updateVisuals()
        else
            if #tubes[index] < currentMode then
                if not isGameActive then
                    startTimer()
                end

                local block = table.remove(tubes[selectedTube])
                local col = tubeCustomColors[selectedTube] and table.remove(tubeCustomColors[selectedTube])
                table.insert(tubes[index], block)
                if col then
                    table.insert(tubeCustomColors[index], col)
                end
                
                moveCount = moveCount + 1
                selectedTube = nil
                updateVisuals()
                updateStatsDisplay()

                if isGameWon() then
                    stopTimer()
                    local finalScore = getScore(moveCount, elapsedTime)
                    statsLabel.Text = string.format("Solved! Moves: %d | Time: %.1fs | Pts: %d", moveCount, elapsedTime, finalScore)
                end
            else
                if #tubes[index] > 0 then
                    selectedTube = index
                    updateVisuals()
                end
            end
        end
    end
end

