local function getFrontStackBoard()
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local hrpPos = hrp.Position
    local look = hrp.CFrame.LookVector
    local candidates = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local name = obj.Name
            -- Strictly match StackBoard1, StackBoard2, or StackBoard<Number>
            if name == "StackBoard1" or name == "StackBoard2" or string.match(name, "^StackBoard%d+$") then
                local cf, _ = obj:GetBoundingBox()
                local toModel = cf.Position - hrpPos
                local dist = toModel.Magnitude
                local dot = look:Dot(toModel.Unit)
                if dot > -0.2 and dist < 120 then
                    table.insert(candidates, {model = obj, score = dist - (dot * 25)})
                end
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.score < b.score
    end)

    return candidates[1] and candidates[1].model or nil
end

local function extractColorId(name)
    local colorName = string.match(name, "Block.*_(%a+)$") or string.match(name, "_(%a+)$") or string.match(name, "Block(%a+)$")
    if colorName then
        local lower = string.lower(colorName)
        if COLOR_NAME_MAP[lower] then
            return COLOR_NAME_MAP[lower]
        end
        if not dynamicColorMap[lower] then
            local assigned = ((#COLOR_PALETTE - 1) % 7) + 1
            dynamicColorMap[lower] = assigned
        end
        return dynamicColorMap[lower]
    end
    return 1
end

local function syncFrom3DBoard()
    local board = getFrontStackBoard()
    if not board then return end

    -- Deduplicate cylinders by index to avoid counting multiple parts per cylinder
    local uniqueCylinders = {}
    for _, part in ipairs(board:GetDescendants()) do
        if part:IsA("BasePart") and string.find(part.Name, "Cylinder") then
            if part.Transparency < 0.8 then
                local num = tonumber(string.match(part.Name, "(%d+)"))
                if num then
                    if not uniqueCylinders[num] or (part.Transparency < uniqueCylinders[num].Transparency) then
                        uniqueCylinders[num] = part
                    end
                end
            end
        end
    end

    -- Build sequential cylinder list 1..N
    local cylinders = {}
    for i = 1, 8 do
        if uniqueCylinders[i] then
            table.insert(cylinders, {part = uniqueCylinders[i], index = i})
        else
            break
        end
    end

    if #cylinders == 0 then return end

    -- Adjust Mode only to the true physical cylinder count
    local detectedCount = #cylinders
    if (detectedCount == 4 or detectedCount == 6 or detectedCount == 8) and detectedCount ~= currentMode then
        currentMode = detectedCount
        changeBtn.Text = "Mode: " .. currentMode
        rebuildCylinders()
    end

    -- Gather opaque 3D blocks (ignoring pickup transparent/ghost blocks)
    local candidateBlocks = {}
    for _, item in ipairs(board:GetDescendants()) do
        if item:IsA("BasePart") and string.find(item.Name, "Block") then
            if item.Transparency < 0.5 then
                table.insert(candidateBlocks, item)
            end
        end
    end

    local newTubes = {}
    local rawTubes = {}
    for i = 1, currentMode do
        newTubes[i] = {}
        rawTubes[i] = {}
    end

    for _, block in ipairs(candidateBlocks) do
        local bPos = block.Position
        local bestCyl = nil
        local bestDist = 9999

        for i = 1, currentMode do
            local cylPart = cylinders[i] and cylinders[i].part
            if cylPart then
                local cPos = cylPart.Position
                local dist2D = math.sqrt((bPos.X - cPos.X)^2 + (bPos.Z - cPos.Z)^2)
                if dist2D < bestDist and dist2D < 4.5 then
                    bestDist = dist2D
                    bestCyl = i
                end
            end
        end

        if bestCyl then
            table.insert(rawTubes[bestCyl], block)
        end
    end

    -- Sort blocks vertically (lowest Y = index 1 at bottom of cylinder)
    for i = 1, currentMode do
        table.sort(rawTubes[i], function(a, b)
            return a.Position.Y < b.Position.Y
        end)
        for _, blk in ipairs(rawTubes[i]) do
            table.insert(newTubes[i], extractColorId(blk.Name))
        end
    end

    -- Mirror state if changes occurred
    local changed = false
    for i = 1, currentMode do
        if not tubes[i] or #tubes[i] ~= #newTubes[i] then
            changed = true
            break
        else
            for s = 1, #tubes[i] do
                if tubes[i][s] ~= newTubes[i][s] then
                    changed = true
                    break
                end
            end
        end
    end

    if changed then
        tubes = newTubes
        updateVisuals()
        updateStatsDisplay()
    end
end

