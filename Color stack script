registerCleanup(randomizeBtn.MouseButton1Click:Connect(randomizeGame))
registerCleanup(startBtn.MouseButton1Click:Connect(toggleSolving))
registerCleanup(changeBtn.MouseButton1Click:Connect(switchMode))
registerCleanup(copyBtn.MouseButton1Click:Connect(toggleCopy))
