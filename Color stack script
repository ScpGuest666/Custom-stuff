-- ============================================================================
-- DYNAMIC REVERSE-WALK RANDOMIZER
-- ============================================================================
local function randomizeGame()
    stopSolving()
    stopTimer()

    selectedTube = nil
    moveCount = 0
    elapsedTime = 0
    isGameActive = false

    local numColors = currentMode - 1
    local capacity = currentMode

    tubes = {}
    for c = 1, numColors do
        tubes[c] = {}
        for _ = 1, capacity do
            table.insert(tubes[c], c)
        end
    end
    tubes[currentMode] = {}

    local walkSteps = math.random(currentMode * 12, currentMode * 22)
    local lastMove = nil

    for _ = 1, walkSteps do
        local validMoves = {}
        for i = 1, currentMode do
            if #tubes[i] > 0 then
                for j = 1, currentMode do
                    if i ~= j and #tubes[j] < capacity then
                        if not lastMove or lastMove[1] ~= j or lastMove[2] ~= i then
                            table.insert(validMoves, {i, j})
                        end
                    end
                end
            end
        end

        if #validMoves == 0 then break end

        local chosen = validMoves[math.random(1, #validMoves)]
        local block = table.remove(tubes[chosen[1]])
        table.insert(tubes[chosen[2]], block)
        lastMove = chosen
    end

    for i = 1, currentMode do
        if #tubes[i] == 0 then
            for j = 1, currentMode do
                if #tubes[j] > 1 then
                    table.insert(tubes[i], table.remove(tubes[j]))
                    break
                end
            end
        end
    end

    for i = currentMode, 2, -1 do
        local j = math.random(1, i)
        tubes[i], tubes[j] = tubes[j], tubes[i]
    end

    local colorMap = {}
    for c = 1, numColors do table.insert(colorMap, c) end
    for i = numColors, 2, -1 do
        local j = math.random(1, i)
        colorMap[i], colorMap[j] = colorMap[j], colorMap[i]
    end
    for i = 1, currentMode do
        for k = 1, #tubes[i] do
            tubes[i][k] = colorMap[tubes[i][k]]
        end
    end

    updateVisuals()
    updateStatsDisplay()
end

-- ============================================================================
-- MANUAL MOVES & MODE SWITCH
-- ============================================================================
onTubeClicked = function(index)
    if isSolving or isGameWon() then return end

    if not selectedTube then
        if #tubes[index] > 0 then
            selectedTube = index
            updateVisuals()
        end
    else
        if selectedTube == index then
            selectedTube = nil
            updateVisuals()
        else
            if #tubes[index] < currentMode then
                if not isGameActive then
                    startTimer()
                end

                local block = table.remove(tubes[selectedTube])
                table.insert(tubes[index], block)
                moveCount = moveCount + 1
                selectedTube = nil
                updateVisuals()
                updateStatsDisplay()

                if isGameWon() then
                    stopTimer()
                    local finalScore = getScore(moveCount, elapsedTime)
                    statsLabel.Text = string.format("Solved! Moves: %d | Time: %.1fs | Pts: %d", moveCount, elapsedTime, finalScore)
                end
            else
                if #tubes[index] > 0 then
                    selectedTube = index
                    updateVisuals()
                end
            end
        end
    end
end

local function switchMode()
    stopSolving()
    stopTimer()

    if currentMode == 4 then
        currentMode = 6
    elseif currentMode == 6 then
        currentMode = 8
    else
        currentMode = 4
    end

    changeBtn.Text = "Mode: " .. currentMode
    rebuildCylinders()
    if copyActive then
        syncFrom3DBoard()
    else
        randomizeGame()
    end
end

-- ============================================================================
-- DYNAMIC A* SOLVER ENGINE
-- ============================================================================
local function serializeState(st)
    local parts = {}
    for i = 1, currentMode do
        parts[i] = table.concat(st[i], "")
    end
    table.sort(parts)
    return table.concat(parts, "|")
end

local function cloneTubes(st)
    local n = {}
    for i = 1, currentMode do
        n[i] = {}
        for j = 1, #st[i] do
            n[i][j] = st[i][j]
        end
    end
    return n
end

local function calculateHeuristic(st)
    local cost = 0
    for i = 1, currentMode do
        local t = st[i]
        local len = #t
        if len > 0 then
            local base = t[1]
            local hasMismatch = false
            for idx = 1, len do
                if t[idx] ~= base then
                    cost = cost + (currentMode + 1 - idx) * 3
                    hasMismatch = true
                else
                    cost = cost - 1
                end
            end
            if not hasMismatch and len == currentMode then
                cost = cost - 15
            end
        end
    end
    return cost
end

local function solveAStar(initialTubes)
    if isGameWon(initialTubes) then return {} end

    local heap = {}
    local function pushHeap(item)
        table.insert(heap, item)
        local idx = #heap
        while idx > 1 do
            local parent = math.floor(idx / 2)
            if heap[idx].f < heap[parent].f then
                heap[idx], heap[parent] = heap[parent], heap[idx]
                idx = parent
            else
                break
            end
        end
    end

    local function popHeap()
        if #heap == 0 then return nil end
        local top = heap[1]
        local last = table.remove(heap)
        if #heap > 0 then
            heap[1] = last
            local idx = 1
            local n = #heap
            while true do
                local left = 2 * idx
                local right = 2 * idx + 1
                local smallest = idx
                if left <= n and heap[left].f < heap[smallest].f then smallest = left end
                if right <= n and heap[right].f < heap[smallest].f then smallest = right end
                if smallest ~= idx then
                    heap[idx], heap[smallest] = heap[smallest], heap[idx]
                    idx = smallest
                else
                    break
                end
            end
        end
        return top
    end

    local startKey = serializeState(initialTubes)
    local visited = {[startKey] = 0}
    pushHeap({
        state = cloneTubes(initialTubes),
        path = {},
        g = 0,
        f = calculateHeuristic(initialTubes)
    })

    local iterations = 0
    local maxLimit = (currentMode == 4) and 10000 or 35000

    while #heap > 0 do
        iterations = iterations + 1
        local current = popHeap()
        local st = current.state

        if isGameWon(st) then
            return current.path
        end

        if iterations > maxLimit then break end

        if iterations % 200 == 0 then
            task.wait()
            if not isAlive or not isSolving then return nil end
        end

        local seenEmptyTarget = false
        for i = 1, currentMode do
            local lenI = #st[i]
            if lenI > 0 then
                local isComplete = false
                if lenI == currentMode then
                    isComplete = true
                    local b = st[i][1]
                    for s = 2, currentMode do
                        if st[i][s] ~= b then
                            isComplete = false
                            break
                        end
                    end
                end

                if not isComplete then
                    local movingVal = st[i][lenI]

                    for j = 1, currentMode do
                        local lenJ = #st[j]
                        if i ~= j and lenJ < currentMode then
                            local isSingleToEmpty = (lenI == 1 and lenJ == 0)
                            local skipDuplicateEmpty = false
                            if lenJ == 0 then
                                if seenEmptyTarget then
                                    skipDuplicateEmpty = true
                                else
                                    seenEmptyTarget = true
                                end
                            end

                            if not isSingleToEmpty and not skipDuplicateEmpty then
                                local nextSt = cloneTubes(st)
                                table.remove(nextSt[i])
                                table.insert(nextSt[j], movingVal)

                                local nextKey = serializeState(nextSt)
                                local newG = current.g + 1

                                if not visited[nextKey] or newG < visited[nextKey] then
                                    visited[nextKey] = newG
                                    local newPath = table.clone(current.path)
                                    table.insert(newPath, {from = i, to = j})
                                    pushHeap({
                                        state = nextSt,
                                        path = newPath,
                                        g = newG,
                                        f = newG + calculateHeuristic(nextSt)
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return nil
end

-- ============================================================================
-- SOLVE CONTROLLER (ON / OFF TOGGLE)
-- ============================================================================
stopSolving = function()
    if not isSolving then return end
    isSolving = false
    if solveThread then
        task.cancel(solveThread)
        solveThread = nil
    end
    selectedTube = nil
    startBtn.Text = "Start (Solve)"
    startBtn.BackgroundColor3 = Color3.fromRGB(180, 115, 30)
    updateVisuals()
end

local function toggleSolving()
    if isSolving then
        stopSolving()
        statsLabel.Text = "Solve stopped."
        return
    end

    if isGameWon() then
        statsLabel.Text = "Already solved!"
        return
    end

    isSolving = true
    startBtn.Text = "Stop (Solve)"
    startBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    selectedTube = nil
    updateVisuals()

    statsLabel.Text = "Calculating optimal moves..."
    task.wait(0.05)

    local solutionPath = solveAStar(tubes)
    if not isAlive or not isSolving then return end

    if solutionPath and #solutionPath > 0 then
        startTimer()

        local totalMoves = #solutionPath
        local stepDelay = math.clamp(4.5 / totalMoves, 0.03, 0.16)
        local hoverDelay = stepDelay * 0.55

        solveThread = task.spawn(function()
            for _, move in ipairs(solutionPath) do
                if not isAlive or not isSolving then break end

                selectedTube = move.from
                updateVisuals()
                task.wait(hoverDelay)

                if not isAlive or not isSolving then break end

                local val = table.remove(tubes[move.from])
                table.insert(tubes[move.to], val)
                moveCount = moveCount + 1
                selectedTube = nil
                updateVisuals()
                updateStatsDisplay()

                task.wait(stepDelay)
            end

            if isSolving then
                isSolving = false
                solveThread = nil
                startBtn.Text = "Start (Solve)"
                startBtn.BackgroundColor3 = Color3.fromRGB(180, 115, 30)

                if isGameWon() then
                    stopTimer()
                    local finalScore = getScore(moveCount, elapsedTime)
                    statsLabel.Text = string.format("Completed! Moves: %d | Time: %.1fs | Pts: %d", moveCount, elapsedTime, finalScore)
                end
            end
        end)
    else
        isSolving = false
        startBtn.Text = "Start (Solve)"
        startBtn.BackgroundColor3 = Color3.fromRGB(180, 115, 30)
        if isGameWon() then
            stopTimer()
            statsLabel.Text = "Already solved!"
        else
            statsLabel.Text = "No path found! Press Randomize."
        end
    end
end

-- ============================================================================
-- BUTTON CONNECTIONS & PERSISTENCE
-- ============================================================================
local function toggleCopy()
    copyActive = not copyActive
    if copyActive then
        copyBtn.Text = "Copy: ON"
        copyBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 60)
        if isOnline then
            syncFrom3DBoard()
        end
    else
        copyBtn.Text = "Copy: OFF"
        copyBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
    end
end

local function setOnline()
    isOnline = true
    status.Text = "Status: Online"
    status.TextColor3 = Color3.fromRGB(50, 230, 80)
    
    mainFrame:TweenSize(UDim2.new(0, 232, 0, 312), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.25, true)
    task.delay(0.15, function()
        if isAlive and isOnline then
            gameContainer.Visible = true
            rebuildCylinders()
            if copyActive then
                syncFrom3DBoard()
            else
                randomizeGame()
            end
        end
    end)
end

local function setOffline()
    isOnline = false
    status.Text = "Status: Offline"
    status.TextColor3 = Color3.fromRGB(255, 75, 75)
    
    stopSolving()
    stopTimer()
    gameContainer.Visible = false
    mainFrame:TweenSize(UDim2.new(0, 232, 0, 58), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.25, true)
end

registerCleanup(onBtn.MouseButton1Click:Connect(setOnline))
registerCleanup(offBtn.MouseButton1Click:Connect(setOffline))
