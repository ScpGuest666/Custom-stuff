-- ============================================================================
-- DYNAMIC A* SOLVER ENGINE
-- ============================================================================
local function serializeState(st)
    local parts = {}
    for i = 1, currentMode do
        parts[i] = table.concat(st[i], "")
    end
    table.sort(parts)
    return table.concat(parts, "|")
end

local function cloneTubes(st)
    local n = {}
    for i = 1, currentMode do
        n[i] = {}
        for j = 1, #st[i] do
            n[i][j] = st[i][j]
        end
    end
    return n
end

local function calculateHeuristic(st)
    local cost = 0
    for i = 1, currentMode do
        local t = st[i]
        local len = #t
        if len > 0 then
            local base = t[1]
            local hasMismatch = false
            for idx = 1, len do
                if t[idx] ~= base then
                    cost = cost + (currentMode + 1 - idx) * 3
                    hasMismatch = true
                else
                    cost = cost - 1
                end
            end
            if not hasMismatch and len == currentMode then
                cost = cost - 15
            end
        end
    end
    return cost
end

local function solveAStar(initialTubes)
    if isGameWon(initialTubes) then return {} end

    local heap = {}
    local function pushHeap(item)
        table.insert(heap, item)
        local idx = #heap
        while idx > 1 do
            local parent = math.floor(idx / 2)
            if heap[idx].f < heap[parent].f then
                heap[idx], heap[parent] = heap[parent], heap[idx]
                idx = parent
            else
                break
            end
        end
    end

    local function popHeap()
        if #heap == 0 then return nil end
        local top = heap[1]
        local last = table.remove(heap)
        if #heap > 0 then
            heap[1] = last
            local idx = 1
            local n = #heap
            while true do
                local left = 2 * idx
                local right = 2 * idx + 1
                local smallest = idx
                if left <= n and heap[left].f < heap[smallest].f then smallest = left end
                if right <= n and heap[right].f < heap[smallest].f then smallest = right end
                if smallest ~= idx then
                    heap[idx], heap[smallest] = heap[smallest], heap[idx]
                    idx = smallest
                else
                    break
                end
            end
        end
        return top
    end

    local startKey = serializeState(initialTubes)
    local visited = {[startKey] = 0}
    pushHeap({
        state = cloneTubes(initialTubes),
        path = {},
        g = 0,
        f = calculateHeuristic(initialTubes)
    })

    local iterations = 0
    local maxLimit = (currentMode <= 5) and 8000 or 15000

    while #heap > 0 do
        iterations = iterations + 1
        local current = popHeap()
        local st = current.state

        if isGameWon(st) then
            return current.path
        end

        if iterations > maxLimit then break end

        if iterations % 350 == 0 then
            task.wait()
            if not isAlive then return nil end
            if not isCopying and not isSolving then return nil end
        end

        local seenEmptyTarget = false
        for i = 1, currentMode do
            local lenI = #st[i]
            if lenI > 0 then
                local isComplete = false
                if lenI == currentMode then
                    isComplete = true
                    local b = st[i][1]
                    for s = 2, currentMode do
                        if st[i][s] ~= b then
                            isComplete = false
                            break
                        end
                    end
                end

                if not isComplete then
                    local movingVal = st[i][lenI]

                    for j = 1, currentMode do
                        local lenJ = #st[j]
                        if i ~= j and lenJ < currentMode then
                            local isSingleToEmpty = (lenI == 1 and lenJ == 0)
                            local skipDuplicateEmpty = false
                            if lenJ == 0 then
                                if seenEmptyTarget then
                                    skipDuplicateEmpty = true
                                else
                                    seenEmptyTarget = true
                                end
                            end

                            if not isSingleToEmpty and not skipDuplicateEmpty then
                                local nextSt = cloneTubes(st)
                                table.remove(nextSt[i])
                                table.insert(nextSt[j], movingVal)

                                local nextKey = serializeState(nextSt)
                                local newG = current.g + 1

                                if not visited[nextKey] or newG < visited[nextKey] then
                                    visited[nextKey] = newG
                                    local newPath = table.clone(current.path)
                                    table.insert(newPath, {from = i, to = j})
                                    pushHeap({
                                        state = nextSt,
                                        path = newPath,
                                        g = newG,
                                        f = newG + calculateHeuristic(nextSt)
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return nil
end

-- ============================================================================
-- FAST DISAPPEAR-ONLY MOVE DISPATCHER
-- ============================================================================
local function executeFastMove(fromIdx, toIdx, initialFromCount)
    local hover = getHoveringTube()

    if hover ~= nil then
        if hover == fromIdx then
            -- Block is already held and hovering: immediately send destination
            simulateKeyPress(toIdx)
        else
            -- Wrong block hovering: drop it down first
            simulateKeyPress(hover)
            local dropWait = os.clock()
            while os.clock() - dropWait < 0.3 do
                if getHoveringTube() == nil then break end
                task.wait()
            end

            -- Now pick up fromIdx
            simulateKeyPress(fromIdx)
            local pickWait = os.clock()
            while os.clock() - pickWait < 0.25 do
                if getHoveringTube() == fromIdx or (#tubes[fromIdx] or 0) < initialFromCount then break end
                task.wait()
            end

            simulateKeyPress(toIdx)
        end
    else
        -- Not hovering: pick up fromIdx
        simulateKeyPress(fromIdx)

        local pickWait = os.clock()
        while os.clock() - pickWait < 0.25 do
            if getHoveringTube() == fromIdx or (#tubes[fromIdx] or 0) < initialFromCount then break end
            task.wait()
        end

        simulateKeyPress(toIdx)
    end

    -- Strictly wait ONLY until the block disappears from the source cylinder
    -- (Does not wait for arrival at toIdx)
    local disappearWait = os.clock()
    local disappeared = false

    while os.clock() - disappearWait < 0.35 do
        if (#tubes[fromIdx] or 0) < initialFromCount and getHoveringTube() ~= fromIdx then
            disappeared = true
            break
        end
        task.wait()
    end

    return disappeared
end

-- ============================================================================
-- ASYNCHRONOUS PIPELINE 3D SOLVER WITH REAL-TIME LANDING VERIFICATION & BACKTRACKING
-- ============================================================================
local function toggle3DSolver()
    if not isCopying then return end

    if isSolving3D then
        isSolving3D = false
        table.clear(pendingLandings)
        mismatchDetected = false
        statsLabel.Text = "3D Solver Stopped."
        return
    end

    if isGameWon(tubes) then
        statsLabel.Text = "Board is already solved!"
        return
    end

    statsLabel.Text = "Calculating 3D moves..."
    task.wait(0.01)

    local solutionPath = solveAStar(tubes)

    if not isAlive or not isCopying then return end

    if not solutionPath or #solutionPath == 0 then
        statsLabel.Text = "3D Solver: Unsolvable or no moves found."
        return
    end

    isSolving3D = true
    table.clear(pendingLandings)
    mismatchDetected = false

    task.spawn(function()
        local pathIndex = 1

        while pathIndex <= #solutionPath do
            if not isAlive or not isCopying or not isSolving3D then break end

            local move = solutionPath[pathIndex]
            local fromIdx = move.from
            local toIdx = move.to

            statsLabel.Text = string.format("3D: %d/%d (%d->%d)", pathIndex, #solutionPath, fromIdx, toIdx)

            -- If the cylinder we need to pick up from is currently waiting for an in-flight block to land, wait for it
            if isCylinderAwaitingArrival(fromIdx) then
                local waitArrival = os.clock()
                while isCylinderAwaitingArrival(fromIdx) and (os.clock() - waitArrival < 1.8) do
                    task.wait()
                end
            end

            local initialFromCount = #tubes[fromIdx] or 0
            local movingColor = tubes[fromIdx] and tubes[fromIdx][initialFromCount]

            -- Execute the move: ONLY waits until the block has successfully lifted and disappeared from fromIdx
            local disappeared = executeFastMove(fromIdx, toIdx, initialFromCount)

            if disappeared then
                -- Register the block as in-flight towards toIdx
                table.insert(pendingLandings, {
                    from = fromIdx,
                    to = toIdx,
                    color = movingColor,
                    timestamp = os.clock()
                })
                -- Immediately advance to the next block (rinse and repeat)
                pathIndex = pathIndex + 1
            else
                -- Input was dropped or block didn't lift: small recovery pause before retrying
                task.wait(0.04)
            end

            -- Check if background landing listener detected any desync / wrong cylinder landing
            if mismatchDetected then
                mismatchDetected = false
                statsLabel.Text = "Mismatch detected! Backtracking..."
                
                -- Allow in-motion blocks to finish settling
                local settleWait = os.clock()
                while os.clock() - settleWait < 0.5 do
                    if getHoveringTube() == nil then break end
                    task.wait()
                end

                table.clear(pendingLandings)

                -- Backtrack: re-calculate the optimal solution path directly from the actual board state
                local fixPath = solveAStar(tubes)
                if fixPath and #fixPath > 0 then
                    solutionPath = fixPath
                    pathIndex = 1
                end
            end

            task.wait()
        end

        -- Pipeline finished: wait for any remaining in-flight blocks to land and confirm final state
        local finalWait = os.clock()
        while #pendingLandings > 0 and (os.clock() - finalWait < 2.0) do
            if mismatchDetected then
                mismatchDetected = false
                local fixPath = solveAStar(tubes)
                if fixPath and #fixPath > 0 then
                    solutionPath = fixPath
                    pathIndex = 1
                    table.clear(pendingLandings)
                end
            end
            task.wait()
        end

        table.clear(pendingLandings)
        isSolving3D = false

        if isGameWon(tubes) then
            statsLabel.Text = "3D Board Solved!"
        else
            statsLabel.Text = "3D Moves Complete."
        end
    end)
end

-- ============================================================================
-- 2D MINI-GAME SOLVER (WHEN COPY IS OFF)
-- ============================================================================
local function startSolving2D()
    if isSolving or isGameWon() then return end
    isSolving = true
    selectedTube = nil
    updateVisuals()

    statsLabel.Text = "Analyzing configuration..."
    task.wait(0.05)

    local solutionPath = solveAStar(tubes)

    if not isAlive or isCopying then return end

    if solutionPath and #solutionPath > 0 then
        startTimer()

        local totalMoves = #solutionPath
        local stepDelay = math.clamp(4.5 / totalMoves, 0.03, 0.16)
        local hoverDelay = stepDelay * 0.55

        task.spawn(function()
            for _, move in ipairs(solutionPath) do
                if not isAlive or not isSolving or isCopying then break end

                selectedTube = move.from
                updateVisuals()
                task.wait(hoverDelay)

                local val = table.remove(tubes[move.from])
                local col = tubeCustomColors[move.from] and table.remove(tubeCustomColors[move.from])
                table.insert(tubes[move.to], val)
                if col then
                    table.insert(tubeCustomColors[move.to], col)
                end
                
                moveCount = moveCount + 1
                selectedTube = nil
                updateVisuals()
                updateStatsDisplay()

                task.wait(stepDelay)
            end

            isSolving = false
            if isGameWon() then
                stopTimer()
                local finalScore = getScore(moveCount, elapsedTime)
                statsLabel.Text = string.format("Completed! Moves: %d | Time: %.1fs | Pts: %d", moveCount, elapsedTime, finalScore)
            end
        end)
    else
        isSolving = false
        if isGameWon() then
            stopTimer()
            statsLabel.Text = "Already solved!"
        else
            statsLabel.Text = "Impossible to solve! (Deadlock detected)"
        end
    end
end

local function onStartClicked()
    if isCopying then
        toggle3DSolver()
    else
        startSolving2D()
    end
end

