local function findTargetBoard()
    local char = player.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    if not root then return nil end

    local rootPos = root.Position
    local lookVec = root.CFrame.LookVector
    local candidates = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name == "StackBoard1" or obj.Name == "StackBoard2") then
            table.insert(candidates, obj)
        end
    end

    if #candidates == 0 then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name == "StackBoard1" or obj.Name == "StackBoard2") then
                table.insert(candidates, obj)
            end
        end
    end

    if #candidates == 0 then return nil end
    if #candidates == 1 then return candidates[1] end

    local bestBoard = nil
    local bestScore = -math.huge

    for _, obj in ipairs(candidates) do
        local pos = nil
        if obj:IsA("Model") then
            local success, cf = pcall(function() return obj:GetBoundingBox() end)
            pos = (success and cf) and cf.Position or obj:GetPivot().Position
        elseif obj:IsA("BasePart") then
            pos = obj.Position
        end

        if pos then
            local toBoard = pos - rootPos
            local dist = toBoard.Magnitude

            if dist < 45 then
                local dir = toBoard.Unit
                local dot = lookVec:Dot(dir)
                local forwardProj = math.max(0, toBoard:Dot(lookVec))
                local rayPoint = rootPos + (lookVec * forwardProj)
                local perpDist = (pos - rayPoint).Magnitude

                local score = (dot * 100) - (perpDist * 3.5) - (dist * 0.8)
                if score > bestScore then
                    bestScore = score
                    bestBoard = obj
                end
            end
        end
    end

    return bestBoard
end

local function parseBlockInfo(part)
    if not part:IsA("BasePart") then return nil end
    if part.Transparency >= 0.9 or (part.LocalTransparencyModifier and part.LocalTransparencyModifier >= 0.9) then
        return nil
    end

    local name = part.Name
    local colorWord = string.match(name, "^Block_%d+_%d+_(%a+)") or string.match(name, "^Block_.*_(%a+)$")
    if not colorWord then return nil end

    local id = COLOR_NAME_MAP[string.lower(colorWord)] or 1
    return {
        part = part,
        colorId = id,
        actualColor = part.Color or COLOR_PALETTE[id]
    }
end

local function stepCopyMirror()
    if not isCopying or not isAlive then return end

    -- Red ↔ Blue color transition on the Start Button
    local t = (math.sin(os.clock() * 3.8) + 1) * 0.5
    local redColor = Color3.fromRGB(235, 60, 60)
    local blueColor = Color3.fromRGB(50, 140, 245)
    startBtn.BackgroundColor3 = redColor:Lerp(blueColor, t)
    startBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    startBtn.Text = isSolving3D and "Stop (3D)" or "Start (3D)"

    local board = findTargetBoard()
    if not board then
        if not isSolving3D then
            statsLabel.Text = "Copying: Searching facing board..."
        end
        return
    end

    if currentTrackedBoard ~= board then
        currentTrackedBoard = board
        table.clear(confirmedCylinderBlocks)
        table.clear(pendingLandings)
        mismatchDetected = false
    end

    -- 1. Gather Cylinders and Ghost Cylinders
    local searchScope = board.Parent or board
    local cylinders = {}
    local ghostCylinders = {}

    for _, obj in ipairs(searchScope:GetDescendants()) do
        if obj:IsA("BasePart") then
            local cNum = string.match(obj.Name, "^Cylinder(%d+)$")
            if cNum then
                cylinders[tonumber(cNum)] = obj
            end
            local gNum = string.match(obj.Name, "^GhostCylinder(%d+)$")
            if gNum then
                ghostCylinders[tonumber(gNum)] = obj
            end
        end
    end

    local maxCyl = 0
    for i = 8, 1, -1 do
        if cylinders[i] then
            maxCyl = math.max(maxCyl, i)
        end
    end

    local detectedCount = maxCyl
    if detectedCount ~= 4 and detectedCount ~= 5 and detectedCount ~= 6 and detectedCount ~= 8 then
        if detectedCount >= 8 then
            detectedCount = 8
        elseif detectedCount >= 6 then
            detectedCount = 6
        elseif detectedCount >= 5 then
            detectedCount = 5
        else
            detectedCount = 4
        end
    end

    if detectedCount ~= currentMode then
        currentMode = detectedCount
        changeBtn.Text = string.format("Mode (%d)", currentMode)
        table.clear(confirmedCylinderBlocks)
        table.clear(pendingLandings)
        mismatchDetected = false
        rebuildCylinders()
    end

    -- 2. Detect & Mirror ONLY Color Blocks That Reached The Cylinder
    local allBlocks = {}

    for partKey in pairs(confirmedCylinderBlocks) do
        if not partKey:IsDescendantOf(workspace) then
            confirmedCylinderBlocks[partKey] = nil
        end
    end

    for _, obj in ipairs(searchScope:GetDescendants()) do
        local info = parseBlockInfo(obj)
        if info then
            local part = info.part
            local pPos = part.Position

            local insideCylinder = false
            for i = 1, currentMode do
                local cyl = cylinders[i]
                if cyl then
                    local distXZ = (Vector2.new(pPos.X, pPos.Z) - Vector2.new(cyl.Position.X, cyl.Position.Z)).Magnitude
                    local cylRadius = math.max(cyl.Size.X, cyl.Size.Z) * 0.85
                    local cylTopY = cyl.Position.Y + (cyl.Size.Y * 0.5)
                    local cylBaseY = cyl.Position.Y - (cyl.Size.Y * 0.5)

                    if distXZ <= cylRadius and pPos.Y <= (cylTopY + 0.1) and pPos.Y >= (cylBaseY - 0.5) then
                        insideCylinder = true
                        break
                    end
                end
            end

            if insideCylinder then
                confirmedCylinderBlocks[part] = true
            end

            if confirmedCylinderBlocks[part] then
                table.insert(allBlocks, info)
            end
        end
    end

    -- 3. Match Blocks to Cylinders by Horizontal Proximity & Detect Active Hover
    local newTubes = {}
    local newColors = {}
    local tubeBlockLists = {}
    for i = 1, currentMode do
        newTubes[i] = {}
        newColors[i] = {}
        tubeBlockLists[i] = {}
    end

    local hoveringTube = nil
    local movingBlockInfo = nil
    local cfg = LAYOUT_CONFIG[currentMode] or LAYOUT_CONFIG[4]

    for _, bInfo in ipairs(allBlocks) do
        local pPos = bInfo.part.Position
        local bestTubeIdx = nil
        local bestDistXZ = math.huge
        local secondTubeIdx = nil
        local secondDistXZ = math.huge

        for i = 1, currentMode do
            local cyl = cylinders[i]
            if cyl then
                local dXZ = (Vector2.new(pPos.X, pPos.Z) - Vector2.new(cyl.Position.X, cyl.Position.Z)).Magnitude
                if dXZ < bestDistXZ then
                    secondTubeIdx = bestTubeIdx
                    secondDistXZ = bestDistXZ
                    bestDistXZ = dXZ
                    bestTubeIdx = i
                elseif dXZ < secondDistXZ then
                    secondDistXZ = dXZ
                    secondTubeIdx = i
                end
            end
        end

        local cylRef = bestTubeIdx and cylinders[bestTubeIdx]
        local cylRadius = cylRef and (math.max(cylRef.Size.X, cylRef.Size.Z) * 0.85) or 3

        if bestTubeIdx and cylRef then
            local topY = cylRef.Position.Y + (cylRef.Size.Y * 0.5)

            if bestDistXZ <= cylRadius then
                if pPos.Y > (topY + 0.08) then
                    hoveringTube = bestTubeIdx
                    bInfo.isHover = true
                else
                    bInfo.isHover = false
                end
                table.insert(tubeBlockLists[bestTubeIdx], bInfo)
            else
                movingBlockInfo = {
                    info = bInfo,
                    fromIdx = bestTubeIdx,
                    toIdx = secondTubeIdx,
                    d1 = bestDistXZ,
                    d2 = secondDistXZ
                }
            end
        end
    end

    -- 4. Order Blocks Vertically Inside Each Cylinder
    for i = 1, currentMode do
        local list = tubeBlockLists[i]
        table.sort(list, function(a, b)
            return a.part.Position.Y < b.part.Position.Y
        end)

        for slotIdx = 1, math.min(#list, currentMode) do
            local b = list[slotIdx]
            table.insert(newTubes[i], b.colorId)
            table.insert(newColors[i], b.actualColor)
        end
    end

    -- 5. Listen to Blocks Appearing in Cylinders and Verify Against Calculating
    if #pendingLandings > 0 then
        for i = 1, currentMode do
            local prevCount = previousTubesCounts[i] or 0
            local newCount = #newTubes[i]

            -- Block has appeared / landed in cylinder 'i'
            if newCount > prevCount then
                local matchedIdx = nil
                for pIdx, pending in ipairs(pendingLandings) do
                    if pending.to == i then
                        matchedIdx = pIdx
                        break
                    end
                end

                if matchedIdx then
                    -- Successfully landed at the exact calculated cylinder!
                    table.remove(pendingLandings, matchedIdx)
                else
                    -- A block appeared in an unexpected cylinder (or fell back to source)
                    mismatchDetected = true
                end
            end
        end

        -- Timeout detection for lost in-flight blocks
        local now = os.clock()
        for _, pending in ipairs(pendingLandings) do
            if now - pending.timestamp > 2.2 then
                mismatchDetected = true
                break
            end
        end
    end

    for i = 1, currentMode do
        previousTubesCounts[i] = #newTubes[i]
    end

    tubes = newTubes
    tubeCustomColors = newColors
    currentHoverTube = hoveringTube
    selectedTube = hoveringTube

    -- 6. Mirror Transit / In-Air Flight Animation
    if movingBlockInfo and tubeButtons[movingBlockInfo.fromIdx] and tubeButtons[movingBlockInfo.toIdx] then
        local btnA = tubeButtons[movingBlockInfo.fromIdx]
        local btnB = tubeButtons[movingBlockInfo.toIdx]
        local totalD = movingBlockInfo.d1 + movingBlockInfo.d2
        local alpha = (totalD > 0) and math.clamp(movingBlockInfo.d1 / totalD, 0, 1) or 0.5

        local xA = btnA.Position.X.Offset
        local xB = btnB.Position.X.Offset
        local yA = btnA.Position.Y.Offset
        local yB = btnB.Position.Y.Offset

        local currentX = xA + ((xB - xA) * alpha) + 3
        local currentY = yA + ((yB - yA) * alpha) + cfg.hoverY

        transitBlock.BackgroundColor3 = movingBlockInfo.info.actualColor
        transitBlock.Position = UDim2.new(0, currentX, 0, currentY)
        transitBlock.Visible = true
    else
        transitBlock.Visible = false
    end

    updateVisuals()
    if not isSolving3D then
        statsLabel.Text = string.format("Copying: %s | %d Cylinders Live", board.Name, currentMode)
    end
end

local function toggleCopy()
    isCopying = not isCopying
    stopTimer()
    isSolving = false
    isSolving3D = false
    selectedTube = nil
    currentHoverTube = nil
    currentTrackedBoard = nil
    table.clear(pendingLandings)
    mismatchDetected = false
    updateButtonLockVisuals()

    if isCopying then
        table.clear(confirmedCylinderBlocks)
        table.clear(previousTubesCounts)
        if copyLoopConn then copyLoopConn:Disconnect() end
        copyLoopConn = RunService.Heartbeat:Connect(stepCopyMirror)
        registerCleanup(copyLoopConn)
        statsLabel.Text = "Copying: Scanning Workspace..."
    else
        if copyLoopConn then
            copyLoopConn:Disconnect()
            copyLoopConn = nil
        end
        table.clear(confirmedCylinderBlocks)
        table.clear(previousTubesCounts)
        transitBlock.Visible = false
        statsLabel.Text = "Copy: OFF | Ready"
        updateVisuals()
    end
end

