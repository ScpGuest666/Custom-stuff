local function isGameWon(checkTubes)
    local st = checkTubes or tubes
    local numColors = currentMode - 1
    local completed = 0
    for i = 1, currentMode do
        local t = st[i]
        if t and #t == currentMode then
            local base = t[1]
            local match = true
            for s = 2, currentMode do
                if t[s] ~= base then
                    match = false
                    break
                end
            end
            if match then
                completed = completed + 1
            else
                return false
            end
        elseif not t or #t ~= 0 then
            return false
        end
    end
    return completed == numColors
end

local function getScore(moves, timeTaken)
    local base = currentMode * 3200
    return math.max(100, math.floor(base - (moves * 25) - (timeTaken * 15)))
end

local function updateStatsDisplay()
    if isCopying then return end
    local curTime = isGameActive and (os.clock() - startTime) or elapsedTime
    local pts = getScore(moveCount, curTime)
    statsLabel.Text = string.format("Moves: %d | Time: %.1fs | Pts: %d", moveCount, curTime, pts)
end

local function stopTimer()
    if timerThread then
        task.cancel(timerThread)
        timerThread = nil
    end
    if isGameActive then
        elapsedTime = os.clock() - startTime
        isGameActive = false
    end
end

local function startTimer()
    if isGameActive or isCopying then return end
    isGameActive = true
    startTime = os.clock() - elapsedTime
    
    if timerThread then task.cancel(timerThread) end
    timerThread = task.spawn(function()
        while isAlive and isGameActive do
            updateStatsDisplay()
            task.wait(0.1)
        end
    end)
    registerCleanup(timerThread)
end

-- ============================================================================
-- INDEPENDENT ADVERSARIAL RANDOMIZER
-- ============================================================================
local function randomizeGame()
    if isCopying then return end
    isSolving = false
    stopTimer()

    selectedTube = nil
    moveCount = 0
    elapsedTime = 0
    isGameActive = false

    local numColors = currentMode - 1
    local totalBlocks = numColors * currentMode

    local heights = {}
    for i = 1, currentMode do heights[i] = 1 end

    local remaining = totalBlocks - currentMode
    while remaining > 0 do
        local candidates = {}
        for i = 1, currentMode do
            if heights[i] < currentMode then
                table.insert(candidates, i)
            end
        end
        if #candidates == 0 then break end
        local chosen = candidates[math.random(1, #candidates)]
        heights[chosen] = heights[chosen] + 1
        remaining = remaining - 1
    end

    for i = currentMode, 2, -1 do
        local j = math.random(1, i)
        heights[i], heights[j] = heights[j], heights[i]
    end

    local pool = {}
    for c = 1, numColors do
        for _ = 1, currentMode do
            table.insert(pool, c)
        end
    end

    for i = #pool, 2, -1 do
        local j = math.random(1, i)
        pool[i], pool[j] = pool[j], pool[i]
    end

    tubes = {}
    tubeCustomColors = {}
    for i = 1, currentMode do
        tubes[i] = {}
        tubeCustomColors[i] = {}
    end

    local sortedIndices = {}
    for i = 1, currentMode do table.insert(sortedIndices, i) end
    table.sort(sortedIndices, function(a, b) return heights[a] > heights[b] end)
    local tA, tB = sortedIndices[1], sortedIndices[2]

    local c1, c2 = 1, 2
    local function removeColor(c)
        for idx, val in ipairs(pool) do
            if val == c then
                table.remove(pool, idx)
                return c
            end
        end
        return c
    end

    removeColor(c1); removeColor(c2);
    removeColor(c2); removeColor(c1);

    table.insert(tubes[tA], c1)
    table.insert(tubes[tA], c2)
    table.insert(tubes[tB], c2)
    table.insert(tubes[tB], c1)

    for i = 1, currentMode do
        local targetH = heights[i]
        while #tubes[i] < targetH and #pool > 0 do
            local lastVal = tubes[i][#tubes[i]]
            local placed = false
            for pIdx = 1, #pool do
                if pool[pIdx] ~= lastVal then
                    table.insert(tubes[i], table.remove(pool, pIdx))
                    placed = true
                    break
                end
            end
            if not placed then
                table.insert(tubes[i], table.remove(pool, 1))
            end
        end
    end

    while #pool > 0 do
        for i = 1, currentMode do
            if #tubes[i] < currentMode and #pool > 0 then
                table.insert(tubes[i], table.remove(pool, 1))
            end
        end
    end

    local perm = {}
    for c = 1, numColors do table.insert(perm, c) end
    for i = numColors, 2, -1 do
        local j = math.random(1, i)
        perm[i], perm[j] = perm[j], perm[i]
    end
    for i = 1, currentMode do
        for k = 1, #tubes[i] do
            tubes[i][k] = perm[tubes[i][k]]
        end
    end

    transitBlock.Visible = false
    updateVisuals()
    statsLabel.Text = "Randomized! (Irregular Heights | Deadlocked)"
end

