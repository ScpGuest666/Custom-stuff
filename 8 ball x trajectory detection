-- ==================== SMART DYNAMIC FILTER & INDIVIDUAL BILLBOARDS ====================
local isTracking = false
local renderConnection = nil
local lastScan = 0
local SCAN_INTERVAL = 0.2

-- Tracking tables
local trackedObjects = {}      -- [instance] = { billboard = ..., anchor = ..., lastPos = Vector3, moveScore = number }
local originalProperties = {}  -- [instance] = { saved props }

-- Save original appearance
local function saveOriginal(inst)
    if originalProperties[inst] then return end

    if inst:IsA("Beam") then
        originalProperties[inst] = {
            Color = inst.Color,
            LightEmission = inst.LightEmission,
            LightInfluence = inst.LightInfluence
        }
    elseif inst:IsA("LineHandleAdornment") or inst:IsA("CylinderHandleAdornment") or inst:IsA("SphereHandleAdornment") then
        originalProperties[inst] = {
            Color3 = inst.Color3
        }
    elseif inst:IsA("BasePart") then
        originalProperties[inst] = {
            Color = inst.Color,
            Material = inst.Material
        }
    end
end

-- Restore individual object
local function restoreObject(inst)
    local props = originalProperties[inst]
    if props and inst and inst.Parent then
        pcall(function()
            for prop, val in pairs(props) do
                inst[prop] = val
            end
        end)
    end
    originalProperties[inst] = nil
end

-- Remove billboard for a specific object
local function removeIndividualBillboard(inst)
    local data = trackedObjects[inst]
    if data then
        if data.billboard then data.billboard:Destroy() end
        if data.anchor then data.anchor:Destroy() end
        trackedObjects[inst] = nil
    end
end

-- Remove all billboards and restore colors
local function cleanupAll()
    for inst, _ in pairs(trackedObjects) do
        removeIndividualBillboard(inst)
        restoreObject(inst)
    end
    table.clear(trackedObjects)
    table.clear(originalProperties)
end

-- Get current 3D position of an object / line
local function getObjectWorldPos(inst)
    if inst:IsA("Beam") and inst.Attachment0 and inst.Attachment1 then
        return (inst.Attachment0.WorldPosition + inst.Attachment1.WorldPosition) / 2
    elseif inst:IsA("BasePart") then
        return inst.Position
    elseif inst:IsA("LineHandleAdornment") or inst:IsA("CylinderHandleAdornment") or inst:IsA("SphereHandleAdornment") then
        local ad = inst.Adornee
        if ad then
            return ad:IsA("BasePart") and ad.Position or (ad:IsA("Attachment") and ad.WorldPosition)
        end
    end
    return nil
end

-- Create or update an INDIVIDUAL billboard directly on this specific line
local function updateIndividualBillboard(inst, worldPos, isTrueLine)
    local data = trackedObjects[inst]
    if not data then
        data = {
            anchor = nil,
            billboard = nil,
            lastPos = worldPos,
            moveScore = 0
        }
        trackedObjects[inst] = data
    end

    -- Create / position 3D anchor part
    if not data.anchor or not data.anchor.Parent then
        data.anchor = Instance.new("Part")
        data.anchor.Name = "LineAnchor_" .. inst.Name
        data.anchor.Size = Vector3.new(0.1, 0.1, 0.1)
        data.anchor.Transparency = 1
        data.anchor.Anchored = true
        data.anchor.CanCollide = false
        data.anchor.Parent = Workspace.CurrentCamera or Workspace
    end
    data.anchor.Position = worldPos

    -- Create individual BillboardGui
    if not data.billboard or not data.billboard.Parent then
        local bb = Instance.new("BillboardGui")
        bb.Name = "LineBillboard_" .. inst.Name
        -- Sized in studs: shrinks and expands with distance
        bb.Size = UDim2.new(5.5, 0, 2.2, 0)
        bb.StudsOffset = Vector3.new(0, 1.2, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = data.anchor
        bb.Parent = guiParent

        local bg = Instance.new("Frame")
        bg.Name = "BG"
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        bg.BackgroundTransparency = 0.2
        bg.BorderSizePixel = 2
        bg.Parent = bb

        local lbl = Instance.new("TextLabel")
        lbl.Name = "InfoLabel"
        lbl.Size = UDim2.new(1, -8, 1, -8)
        lbl.Position = UDim2.new(0, 4, 0, 4)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.TextScaled = true
        lbl.Font = Enum.Font.SourceSansBold
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextYAlignment = Enum.TextYAlignment.Top
        lbl.Parent = bg

        data.billboard = bb
    end

    -- Update info text & border
    local bg = data.billboard:FindFirstChild("BG")
    local lbl = bg and bg:FindFirstChild("InfoLabel")
    if bg and lbl then
        if isTrueLine then
            bg.BorderColor3 = Color3.fromRGB(0, 255, 0)
            lbl.Text = string.format(
                "✅ [TRUE LINE]\n• Name: %s\n• Class: %s\n• Parent: %s\n• Path: %s",
                inst.Name,
                inst.ClassName,
                inst.Parent and inst.Parent.Name or "None",
                inst:GetFullName()
            )
        else
            bg.BorderColor3 = Color3.fromRGB(255, 170, 0)
            lbl.Text = string.format(
                "🔍 [CANDIDATE]\n• Name: %s\n• Class: %s\n• Parent: %s",
                inst.Name,
                inst.ClassName,
                inst.Parent and inst.Parent.Name or "None"
            )
        end
    end
end

-- Filter helpers
local function isCharacter(inst)
    local model = inst:FindFirstAncestorOfClass("Model")
    while model do
        if model:FindFirstChildOfClass("Humanoid") then
            return true
        end
        model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model")
    end
    return false
end

local function isRoomGeometry(inst)
    local path = string.lower(inst:GetFullName())
    return string.find(path, "lobby") or string.find(path, "wall") or string.find(path, "ceiling") or string.find(path, "floor") or string.find(path, "building")
end

-- Scan candidate trajectory objects
local function scanCandidates()
    local camera = Workspace.CurrentCamera
    if not camera then return {} end

    local camPos = camera.CFrame.Position
    local camLook = camera.CFrame.LookVector
    local results = {}

    local function evaluate(inst, pos, isFlat)
        if not pos or not isFlat then return end
        if isCharacter(inst) or isRoomGeometry(inst) or string.find(inst.Name, "LineAnchor_") then return end

        local offset = (pos - camPos)
        local dist = offset.Magnitude

        -- Must be in front of camera on pool table (2 to 35 studs)
        if dist >= 2 and dist <= 35 and camLook:Dot(offset.Unit) > 0.35 then
            table.insert(results, { object = inst, pos = pos })
        end
    end

    -- Scan Camera
    for _, item in ipairs(camera:GetDescendants()) do
        if item:IsA("Beam") and item.Enabled and item.Attachment0 and item.Attachment1 then
            local p0 = item.Attachment0.WorldPosition
            local p1 = item.Attachment1.WorldPosition
            local delta = (p1 - p0)
            local dY = math.abs(delta.Y)
            local isFlat = (dY <= 0.8) and (delta.Magnitude > 0.5) and (dY / delta.Magnitude < 0.25)
            evaluate(item, (p0 + p1) / 2, isFlat)
        elseif item:IsA("BasePart") and item.Transparency < 0.95 then
            local isFlat = math.abs(item.CFrame.LookVector.Y) < 0.4 or math.abs(item.CFrame.RightVector.Y) < 0.4
            evaluate(item, item.Position, isFlat)
        elseif (item:IsA("LineHandleAdornment") or item:IsA("CylinderHandleAdornment") or item:IsA("SphereHandleAdornment")) and item.Visible then
            local pos = getObjectWorldPos(item) or (camPos + camLook * 8)
            evaluate(item, pos, true)
        end
    end

    -- Scan Workspace
    for _, item in ipairs(Workspace:GetDescendants()) do
        if not isCharacter(item) and not isRoomGeometry(item) then
            if item:IsA("Beam") and item.Enabled and item.Attachment0 and item.Attachment1 then
                local p0 = item.Attachment0.WorldPosition
                local p1 = item.Attachment1.WorldPosition
                local delta = (p1 - p0)
                local dY = math.abs(delta.Y)
                local isFlat = (dY <= 0.8) and (delta.Magnitude > 0.5) and (dY / delta.Magnitude < 0.25)
                evaluate(item, (p0 + p1) / 2, isFlat)
            elseif (item:IsA("LineHandleAdornment") or item:IsA("CylinderHandleAdornment") or item:IsA("SphereHandleAdornment")) and item.Visible then
                local pos = getObjectWorldPos(item)
                if pos then evaluate(item, pos, true) end
            elseif item:IsA("BasePart") and item.Transparency < 0.95 then
                local name = string.lower(item.Name)
                local isAimName = string.find(name, "aim") or string.find(name, "guide") or string.find(name, "traj") or string.find(name, "line") or string.find(name, "ghost") or string.find(name, "target")
                local isThin = (item.Size.X <= 0.6 and item.Size.Y <= 0.6) or (item.Size.X <= 0.6 and item.Size.Z <= 0.6) or (item.Size.Y <= 0.6 and item.Size.Z <= 0.6)
                local isFlat = math.abs(item.CFrame.LookVector.Y) < 0.4 or math.abs(item.CFrame.RightVector.Y) < 0.4
                if (isAimName or isThin) and isFlat then
                    evaluate(item, item.Position, true)
                end
            end
        end
    end

    return results
end

-- Rainbow Color Application
local function applyRainbow(target)
    local rainbowColor = Color3.fromHSV((tick() * 1.5) % 1, 1, 1)
    pcall(function()
        if target:IsA("Beam") then
            target.Color = ColorSequence.new(rainbowColor)
            target.LightEmission = 1
            target.LightInfluence = 0
        elseif target:IsA("LineHandleAdornment") or target:IsA("CylinderHandleAdornment") or target:IsA("SphereHandleAdornment") then
            target.Color3 = rainbowColor
        elseif target:IsA("BasePart") then
            target.Color = rainbowColor
            target.Material = Enum.Material.Neon
        end
    end)
end

-- Main Loop: Tracking + Swivel Movement Signature Filter
local function startDetection()
    if renderConnection then renderConnection:Disconnect() end

    renderConnection = RunService.RenderStepped:Connect(function()
        if not isTracking then return end

        local now = tick()
        if now - lastScan > SCAN_INTERVAL then
            lastScan = now
            local candidates = scanCandidates()
            local activeSet = {}

            for _, cand in ipairs(candidates) do
                local obj = cand.object
                local curPos = cand.pos
                activeSet[obj] = true

                saveOriginal(obj)

                -- Check dynamic movement (swivel detection)
                local data = trackedObjects[obj]
                local isMoving = false
                if data and data.lastPos then
                    local deltaMove = (curPos - data.lastPos).Magnitude
                    if deltaMove > 0.02 then
                        data.moveScore = math.min((data.moveScore or 0) + 1, 10)
                    else
                        data.moveScore = math.max((data.moveScore or 0) - 0.2, 0)
                    end
                    data.lastPos = curPos
                    isMoving = (data.moveScore > 1)
                end

                updateIndividualBillboard(obj, curPos, isMoving)
            end

            -- Clean up elements that disappeared
            for oldObj, _ in pairs(trackedObjects) do
                if not activeSet[oldObj] then
                    removeIndividualBillboard(oldObj)
                    restoreObject(oldObj)
                end
            end
        end

        -- Rainbow updates and status text
        local count = 0
        local trueCount = 0
        for obj, data in pairs(trackedObjects) do
            if obj and obj.Parent then
                applyRainbow(obj)
                count = count + 1
                if data.moveScore and data.moveScore > 1 then
                    trueCount = trueCount + 1
                end
            end
        end

        if count > 0 then
            if trueCount > 0 then
                status.Text = string.format("Status: True Line Active (%d)", trueCount)
                status.TextColor3 = Color3.fromRGB(0, 255, 0)
            else
                status.Text = string.format("Status: Tracking (%d Lines)", count)
                status.TextColor3 = Color3.fromRGB(255, 200, 0)
            end
        else
            status.Text = "Status: Waiting for Turn"
            status.TextColor3 = Color3.fromRGB(255, 170, 0)
        end
    end)
end

-- Stop Detection & Revert Colors
local function stopDetection()
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end
    cleanupAll()
    status.Text = "Status: Offline"
    status.TextColor3 = Color3.fromRGB(255, 0, 0)
end

